# Machine-specific values for the harness scripts. Copy to scripts/site.env
# (gitignored) and fill in. scripts/site.sh loads it; every script that talks
# to a real host or guest reads these instead of spelling them out.

# The Linux machine that runs the Windows VM.
SITE_HOST_USER='<host-user>'
SITE_HOST_IP='<host-ip>'
# ssh alias or hostname the host is reached by from this machine.
SITE_HOST_ALIAS='<host>'
# HostKeyAlias the host's ssh key is recorded under in known_hosts.
SITE_HOST_KEYALIAS='<host-fqdn>'
# The host user's home directory, spelled out where a path must be absolute.
SITE_HOST_HOME='/home/<host-user>'
# The host as the guest sees it, on the VM's private network.
SITE_HOST_NAT_IP='<host-nat-ip>'

# The Windows guest.
SITE_GUEST_USER='<guest-user>'
SITE_GUEST_IP='<guest-ip>'
# The guest as the host sees it, on the VM's private network.
SITE_GUEST_NAT_IP='<guest-nat-ip>'

# The macOS VM's user-mode network gateway (QEMU's slirp host address).
SITE_VM_GATEWAY_IP='<vm-gateway-ip>'

# ssh agent socket holding the keys for the guest.
SITE_AGENT_SOCK='<agent-socket>'
