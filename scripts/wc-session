#!/usr/bin/env bash
# wc-session -- the VM host's half of the launcher. Stage 14.
#
# §105: NO GUEST REACHES THIS SCRIPT OVER SSH ANY MORE. The verbs below are run
# by the host's session service (`wc-arena-host sessiond`, which starts a
# session from the boot record the guest writes into shared memory, with
# WC_LAUNCH_SERVICE=1) and by the proxy for each line on the session's control
# ring (`wc_proxy::macsvc`). Both hand the words over in $SSH_ORIGINAL_COMMAND,
# exactly as the forced command did, so the validation below is the same code
# whichever way a request arrived. The forced-command key described next is
# installed only for the opt-in debug transport (WC_LAUNCH_DEBUG_SSH_TRANSPORT=1).
#
# It is installed on the VM host at ~/wc-launch/wc-session and is the **forced
# command** of the guest's key in ~/.ssh/authorized_keys:
#
#   restrict,port-forwarding,command="~/wc-launch/wc-session" ssh-ed25519 ...
#
# So the guest cannot run anything on this machine except the verbs below, and
# the command it asked for arrives in $SSH_ORIGINAL_COMMAND rather than as this
# script's argv. That is the whole reason the key can live on a Windows guest
# that anybody with the screen unlocked can read: it opens a Wayland session and
# starts the applications this machine defines, and it is not a shell.
#
# §94: AND IT NAMES APPLICATIONS, IT DOES NOT SEND COMMANDS. Until §94 `run`
# took a base64'd command line from the guest and ran it, so the key could run
# any program here (security-model.md R33). Now every application is a section
# of $APPS (`apps.ini` beside this script, written by the deploy step): its
# executable, fixed arguments, profile, preferences, title bar, environment,
# desktop entry and whether the forwarded GPU applies. The guest names a
# section, and for a jump-list entry an action id or a URL; the only free
# values it sends are the desktop's DPI and caption height, as numbers.
#
#   wc-session ping
#   wc-session up   ID RUNID ivshmem          check the ivshmem arena's header against
#                                             the run id the compositor printed. No
#                                             root and no locate: the product path (§83).
#   wc-session up   ID RUNID PAGES OUTBOUND [frames]
#                                             locate the guest-RAM arena, as root. Refused
#                                             unless this host set WC_LAUNCH_GUEST_RAM=1 (§94).
#                                             With WC_LAUNCH_GUEST_RAM_USER=1 and
#                                             WC_LAUNCH_ROOTC=bash, as this user: a QEMU that
#                                             runs as this user, the macOS guest of §103
#   wc-session proxy ID                       start wc-proxy: as this user on an
#                                             ivshmem session, as root on a guest-RAM one
#   wc-session run    ID APP DPI CAPTION      start the application APP of $APPS against
#                                             that proxy (§94)
#   wc-session action ID APP ACTION DPI CAPTION
#                                             run one of APP's desktop-entry actions, by id (§92)
#   wc-session open   ID APP B64URL DPI CAPTION
#                                             open an http(s)/file URL in the slot its %u marks (§92)
#   wc-session gpu  ID N                      serve the guest's GPU process's sessions to this
#                                             session's ICDs, as this user, on ivshmem (§86, §87)
#   wc-session audio ID                       the session's sound as raw PCM on stdout (§86)
#   wc-session icon APP                       APP's icon from this machine's theme
#   wc-session app  APP THEME                 APP's desktop entry: name, actions, task
#                                             icons and icon, for the guest's pin and jump list (§92)
#   wc-session frequent APP                   the jump list's frequent pages of APP's profile (§92)
#   wc-session down ID                        stop the proxy and remove the run directory
#   wc-session status ID
#   wc-session logs ID
#
# DPI is 48..960 and CAPTION 0..512 (0: not measured), decimal. Operator verbs,
# from argv on this machine and refused from the guest:
#
#   wc-session apps                           check $APPS and print each definition
#   wc-session resolve NAME                   where a program name resolves here
#   wc-session pw-stack DIR                   write a private PipeWire stack for DIR (§106.3)
#
# THE ARENA IS NEVER A FILE ARENA, AND SINCE §83 THE PRODUCT PATH HAS NO ROOT
#
# Two substrates reach this script, and on both the guest and this machine map
# the same physical pages:
#
#   * IVSHMEM, the product path (docs/waycompose-design.md §83). The compositor maps
#     BAR2 of a QEMU ivshmem-plain device, and QEMU backs that BAR with $ARENA,
#     a file whose group is what lets this user open it. `up ID RUNID ivshmem`
#     checks the header the compositor wrote against the run id it printed;
#     `proxy` runs wc-proxy **as this user** in a user unit; `down` stops that
#     unit. $ROOTC is called by none of the three. If the file is absent or this
#     user cannot open it, `up` fails and says so. There is no fallback to the
#     guest-RAM path (§34.2): a session that quietly became root again would be
#     the regression §83 exists to remove.
#   * GUEST RAM, the developer harnesses' path, kept as it was and described
#     below. It needs root for the reason §12.9 gives, and since §94 it is
#     refused unless this host sets WC_LAUNCH_GUEST_RAM=1: nothing of ours asks
#     for it, and it was the one way from the guest's key to $ROOTC.
#
# THE GUEST-RAM ARENA
#
# `up` takes a run id and a page count that only a compositor which has pinned
# and stamped its own memory can produce, and `proxy` starts wc-proxy with
# `--transport arena --arena-plan`, spelled in this file and reachable from no
# argument. There is no verb that names a file-backed arena and no flag that
# selects one. docs/waycompose-design.md §28.2: a file arena is a Wine-only fixture, and a
# launcher that could quietly fall back to one is how tearing reaches a screen.
#
# WHY ROOT, AND ONLY FOR TWO STEPS
#
# QEMU is a *system* service on this machine, so its QMP socket and its
# /proc/<pid>/fd are root-only (§12.9). `wc-arena-host` reads both to find the
# arena's pages, and `wc-proxy` opens the backing object by that path. Nothing
# else here is privileged: the application runs as the invoking user, with that
# user's home and that user's Firefox cache, and reaches the proxy through a
# socket the proxy's unit chowns to them.
#
# $ROOTC is how this deployment becomes root and is the deployment's business.
# On testhost it is ~/rootc (docs/waycompose-design.md §12.9). A machine that ran QEMU as
# the developer -- which is how shared_vulkan's own boundary is deployed --
# would set ROOTC=bash and lose nothing.
set -uo pipefail

# The directory this script was installed in, so that an installation that is
# not ~/wc-launch runs its *own* binaries: the forced command names the script
# and nothing else, and a fixed default here ran a second install's wc-session
# against the first install's wc-proxy (found by §83's session-0 run).
BASE="${WC_LAUNCH_BASE:-$(cd "$(dirname "$0")" && pwd)}"
BIN="$BASE/bin"
RUNROOT="${WC_LAUNCH_RUN:-/tmp/wc-launch}"
ROOTC="${WC_LAUNCH_ROOTC:-$HOME/rootc}"
# IVSHMEM ARENA. Made by the VM's own unit, 0660 root:wc-arena (§83).
ARENA="${WC_LAUNCH_ARENA:-/run/windows-vm/wc-arena/arena}"
# The GPU sessions' arena, a second ivshmem device, and the doorbell port's
# chardev socket; both made by the VM's own unit for the same group (§87).
GPUREGION="${WC_LAUNCH_GPU_REGION:-/run/windows-vm/wc-arena/gpu}"
BELL="${WC_LAUNCH_BELL:-/run/windows-vm/wc-arena/svbell.sock}"
# The Wayland rings' doorbell (§89): QEMU's socket for the virtio-serial port
# org.sirati.wcbell.0, made by the VM's unit for the same group.
WCBELL="${WC_LAUNCH_WCBELL:-/run/windows-vm/wc-arena/wcbell.sock}"
# THE SHARED DOORBELL HUB (docs/waycompose-design.md §99). QEMU serves each
# doorbell socket above to one connection, so no session may hold one: the
# user unit wc-bell-hub.service (`sv-hostd bell-hub`, installed by deploy)
# holds both for every session of every installation and serves them here.
# Without it a session falls back to holding the port itself, said loudly.
HUBDIR="${WC_LAUNCH_BELL_HUB:-/run/user/$(id -u)/wc-bell}"
# Whether the hub RUNS, not whether its socket files exist: they outlive it
# (with the fd store they are meant to), and a session that trusted a stale
# file had no GPU doorbell and sent its Wayland connections over ssh (§99.8).
hub_up() {
  # A harness that runs its own hub, outside systemd (scripts/wc-no-ssh.sh).
  if [ "${WC_LAUNCH_HUB_UNMANAGED:-}" = 1 ]; then
    [ -S "$HUBDIR/sv.sock" ] || [ -S "$HUBDIR/wl.sock" ]; return
  fi
  local sd="env XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user"
  $sd is-active --quiet wc-bell-hub.service || $sd start wc-bell-hub.service >/dev/null 2>&1 || return 1
  for _ in $(seq 1 40); do
    $sd is-active --quiet wc-bell-hub.service && [ -S "$HUBDIR/sv.sock" ] && [ -S "$HUBDIR/wl.sock" ] && return 0
    sleep 0.05
  done
  return 1
}
# The Wayland doorbell a proxy connects to: the hub's, or QEMU's own socket.
# The hub's Wayland socket, when a hub runs and serves it. A guest that
# hosts the sessions itself (§103.17, role b) has only that: its hub holds the
# guest's own port, and there is no QEMU socket at $WCBELL.
wl_hub() {
  [ -S "$HUBDIR/wl.sock" ] || return 1
  [ "${WC_LAUNCH_HUB_UNMANAGED:-}" = 1 ] && return 0
  env XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user is-active --quiet wc-bell-hub.service
}
wcbell_use() { if wl_hub || hub_up; then echo "$HUBDIR/wl.sock"; else echo "$WCBELL"; fi; }
QMP="${WC_LAUNCH_QMP:-/run/windows-vm/qmp.sock}"
VM_HINT="${WC_LAUNCH_VM:-windows-vm}"
UID_=$(id -u)
GID_=$(id -g)

# §94. The application definitions. One section per application the guest may
# start, written by `scripts/wc-launch.sh deploy`; see `load_app`.
APPS="${WC_LAUNCH_APPS:-$BASE/apps.ini}"
# §102. How much of a buffer the proxy copies into the arena at each commit:
# `damage` (the default, §27) or `buffer`, from `$BASE/copy-scope`, which the
# deploy step writes and nothing the guest sends can change. The nested Linux
# desktop's installation uses `buffer`: with `damage`, KWin's frames reached
# the guest's window only at its first map and never after (§102.9), and the
# cost of `buffer` is one window-sized copy per frame on the host.
COPY_SCOPE=damage
if [ -f "$BASE/copy-scope" ]; then
  case "$(head -c 16 "$BASE/copy-scope" | tr -d '[:space:]')" in
    buffer) COPY_SCOPE=buffer ;;
    damage|'') ;;
    *) echo "wc-session: $BASE/copy-scope is not damage or buffer; using damage" >&2 ;;
  esac
fi

# §104. The render node the proxy offers zwp_linux_dmabuf_v1 for, from
# `$BASE/dmabuf-node` (one path, written by the deploy step like copy-scope):
# a nested KWin then renders with OpenGL into shared sections and the proxy
# copies nothing. Only a /dev/dri/renderD<N> path is taken. The node need not
# exist yet -- sv-drm's CUSE device appears when the nested seat starts it,
# and the proxy looks for it again for every client.
DMABUF_ARGS=""
if [ -f "$BASE/dmabuf-node" ]; then
  DMABUF_NODE=$(head -c 64 "$BASE/dmabuf-node" | tr -d '[:space:]')
  if [[ "$DMABUF_NODE" =~ ^/dev/dri/renderD[0-9]+$ ]]; then
    DMABUF_ARGS="--dmabuf-node $DMABUF_NODE"
  elif [ -n "$DMABUF_NODE" ]; then
    echo "wc-session: $BASE/dmabuf-node is not a /dev/dri/renderD<N> path; no dma-buf" >&2
  fi
fi

die() { echo "wc-session: $*" >&2; exit 1; }

# THE REQUEST (§94). The forced command puts it in $SSH_ORIGINAL_COMMAND; argv
# is how this script is driven by hand on this machine, and is never the
# guest's: the forced command names this script with no arguments.
#
# The request is refused whole, before any verb sees it, unless it is at most
# 16 KiB, at most 12 words, and made only of the characters some verb needs:
# letters, digits, space and `+ / = . _ -` (ids, numbers, base64). No shell
# metacharacter, quote, `*`, `?`, `[`, `~`, `$`, newline, control character or
# non-ASCII byte gets as far as a verb. It is split with `read -a`, which does
# no pathname expansion: `set -- $SSH_ORIGINAL_COMMAND`, which this was until
# §94, globbed every word against this user's home directory. The list of
# characters is spelled out rather than written as ranges, because a range in a
# bracket expression follows the locale's collation and this list must not.
GUEST=""
if [ -n "${SSH_ORIGINAL_COMMAND+set}" ]; then
  GUEST=1
  [ "${#SSH_ORIGINAL_COMMAND}" -le 16384 ] || die "request longer than 16384 bytes"
  case "$SSH_ORIGINAL_COMMAND" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\ +/=._-]*)
      die "request with a character no verb takes (only letters, digits, space and + / = . _ -)" ;;
  esac
  read -r -a REQ <<<"$SSH_ORIGINAL_COMMAND"
  [ "${#REQ[@]}" -le 12 ] || die "request of more than 12 words"
  set -- "${REQ[@]}"
fi
VERB="${1:-}"; shift 2>/dev/null || true

# words MIN MAX USAGE "$@": the verb's word count, or a refusal that says the
# verb's shape. Extra words are refused rather than ignored, so that a request
# in an older shape -- `run` with a command line -- fails by name (§94).
words() {
  local min="$1" max="$2" usage="$3"; shift 3
  [ "$#" -ge "$min" ] && [ "$#" -le "$max" ] || die "$VERB takes $usage"
}

# A session id: a letter or digit, then letters, digits, `_` and `-`, at most
# 64. It becomes a directory name and a systemd unit name; the first character
# keeps it out of every option position.
check_id() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || die "bad id"
}

# check_metrics DPI CAPTION: the two numbers the guest measures (§94), decimal
# without leading zeros, DPI 48..960 and CAPTION 0..512. The renderer checks the
# ranges again (`plan::host_files`).
check_metrics() {
  [[ "${1:-}" =~ ^[1-9][0-9]{1,2}$ ]] && [ "$1" -ge 48 ] && [ "$1" -le 960 ] || die "bad dpi (48..960)"
  [[ "${2:-}" =~ ^(0|[1-9][0-9]{0,2})$ ]] && [ "$2" -le 512 ] || die "bad caption height (0..512)"
}

dir_of() { echo "$RUNROOT/$1"; }

# WHERE AN APPLICATION ACTUALLY IS, WHICH IS NOT A CONSTANT
#
# The brief for this stage named Firefox at
# `/nix/store/9ndgaj…-system-path/bin/firefox` and said not to ship that string,
# because it changes on every rebuild. It was already wrong four hours later --
# and not in the way anybody expected: the *current* system path has no
# `bin/firefox` at all, so `/run/current-system/sw/bin/firefox` does not resolve
# either and neither does `command -v firefox`. Firefox is on this machine, in
# the store, in a generation that is still a GC root.
#
# So a name is resolved here, in this order, and the answer is printed with the
# window so that a run always says which binary it got:
#
#   1. an absolute path, if it is one and it is executable -- an operator who
#      names a build gets that build;
#   2. `command -v`, which is the right answer on any ordinary machine;
#   3. the newest `/nix/store/*-<name>-<version>/bin/<name>`, which is the
#      answer on this one. `-[0-9]` in the glob so that `firefox-unwrapped` is
#      not mistaken for `firefox`.
#
# Step 3 is a store search and it is deliberate: the alternative is a path in a
# configuration file that a garbage collection silently invalidates, and the
# symptom of that is a shortcut that does nothing.
#
# §94: **at deploy time, not when the guest asks.** Until §94 `run` resolved the
# first word of the guest's command line with this, so the guest chose the
# program. Now an application's `exec` in $APPS is an absolute path, the deploy
# step resolves a name with the operator verb `resolve` and GC-roots a store
# path it lands on, and this is left for the tools (`pulse_bin`) and for that.
resolve_exec() {
  local want="$1"
  case "$want" in
    /*) [ -x "$want" ] && { echo "$want"; return 0; } ;;
  esac
  local base; base=$(basename "$want")
  local p; p=$(command -v "$base" 2>/dev/null)
  [ -n "$p" ] && { echo "$p"; return 0; }
  # Sorted by what follows the hash, not by the whole path: `sort -V` over
  # whole store paths orders them by hash, and on testhost that picked
  # firefox-151.0.2 over 157.0.1 -- a Firefox that never loaded the forwarded
  # GPU (waycompose-design.md §87).
  p=$(ls -d /nix/store/*-"$base"-[0-9]*/bin/"$base" 2>/dev/null \
        | sed 's|^/nix/store/[^-]*-\(.*\)$|\1\t&|' | sort -V | tail -1 | cut -f2)
  [ -n "$p" ] && [ -x "$p" ] && { echo "$p"; return 0; }
  return 1
}


# ------------------------------------------------------------ APPLICATIONS ---
# docs/waycompose-design.md §92: the guest's pinned button, Start menu entry
# and jump list are built from the application's desktop entry, which is on
# this machine. These helpers find it and the tools that read it.

# A tool from a package: the deploy step's GC-rooted link `$BIN/<pkg>` first
# (WC_LAUNCH_SQLITE, WC_LAUNCH_RSVG), then PATH, then the newest
# `/nix/store/*-<pkg>-<version>*/bin/<tool>`, sorted by what follows the hash.
store_tool() {
  local pkg="$1" tool="$2" p
  if [ -x "$BIN/$pkg/bin/$tool" ]; then echo "$BIN/$pkg/bin/$tool"; return 0; fi
  p=$(command -v "$tool" 2>/dev/null) && [ -n "$p" ] && { echo "$p"; return 0; }
  p=$(ls -d /nix/store/*-"$pkg"-[0-9]*/bin/"$tool" 2>/dev/null \
        | sed 's|^/nix/store/[^-]*-\(.*\)$|\1\t&|' | sort -V | tail -1 | cut -f2)
  [ -n "$p" ] && [ -x "$p" ] && { echo "$p"; return 0; }
  return 1
}

# The data directories an application's desktop entry may be in, most specific
# first, `:`-separated, for `wc-proxy desktop --dirs`:
#   1. `share` beside the executable the launcher runs, walking up as the icon
#      resolver does (icons::client_prefix_dirs);
#   2. the package of the same name in the store, newest version first -- the
#      readback Firefox has no `share/` at all (§90.4), and the stock package
#      of the same version carries the same firefox.desktop;
#   3. the user's and the system's data directories.
app_dirs() {
  local exe real d out="" pkg
  exe=$(resolve_exec "$1" 2>/dev/null || true)
  if [ -n "$exe" ]; then
    real=$(readlink -f "$exe")
    d=$(dirname "$real")
    for _ in 1 2 3 4; do
      [ "$d" = / ] && break
      [ -d "$d/share" ] && out="$out:$d/share"
      d=$(dirname "$d")
    done
    for pkg in $(ls -d /nix/store/*-"$(basename "$exe")"-[0-9]*/share 2>/dev/null \
                   | sed 's|^/nix/store/[^-]*-\(.*\)$|\1\t&|' | sort -rV | cut -f2 | head -3); do
      out="$out:$pkg"
    done
  fi
  out="$out:${XDG_DATA_HOME:-$HOME/.local/share}:$HOME/.nix-profile/share"
  out="$out:/etc/profiles/per-user/$(id -un)/share:/run/current-system/sw/share:/usr/local/share:/usr/share"
  echo "${out#:}"
}

# An application id as the guest names it (§94): a section of $APPS. A letter or
# digit first, then letters, digits, `.`, `_`, `-` and `+`, no `..`, at most 64;
# `config::host_app_ok` on the guest is the same rule. A desktop id is checked
# with it too (wc-proxy checks that one again).
check_app() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]] && [[ "$1" != *..* ]] || die "bad app id"
}

# ---------------------------------------------------- THE HOST'S APPLICATIONS ---
# docs/waycompose-design.md §94. Everything that decides what runs on this
# machine when the guest names an application, in one file this machine owns:
#
#   [firefox]
#   exec     = ~/wc-launch-ivs/bin/firefox-readback/bin/firefox
#   args     =                        fixed arguments, split on whitespace
#   profile  = ~/.wc-launch/firefox
#                                     `--profile DIR` is added, and DIR is where
#                                     user.js and userChrome.css are written
#   prefs    = middlemouse.paste=false
#                                     `[app.*] prefs` syntax, rendered into user.js
#   titlebar = tabs                   tabs, none or client (§82)
#   desktop  = firefox                the desktop entry: name, icon, actions (§92)
#   gpu      = on                     whether gpu.env applies (§86); default on
#   env      = NAME=value             repeatable, put in front of the application
#
# `exec` is an absolute path to an executable and is never resolved by name at
# run time: the deploy step resolved it (`wc-session resolve`) and, for a store
# path, rooted it. The readback Firefox (§86) is chosen by pointing `exec` at it;
# its marker beside the browser still decides the decode preferences. A key this
# parser does not know is refused, as `wc-launch.ini`'s parser refuses one,
# because a typo here is a setting silently not applied.
#
# load_app APP sets DEF_EXEC, DEF_ARGS (array), DEF_PROFILE, DEF_PREFS,
# DEF_TITLEBAR, DEF_DESKTOP, DEF_GPU and DEF_ENV (array), or dies.
load_app() {
  local want="$1" sec="" line k v found=""
  check_app "$want"
  DEF_EXEC=""; DEF_ARGS=(); DEF_PROFILE=""; DEF_PREFS=""; DEF_TITLEBAR=tabs
  DEF_DESKTOP="$want"; DEF_GPU=on; DEF_ENV=()
  [ -f "$APPS" ] || die "no applications are defined on this host ($APPS is missing; the deploy step writes it)"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    case "$line" in
      ''|'#'*|';'*) continue ;;
      '['*']') sec="${line:1:${#line}-2}"; [ "$sec" = "$want" ] && found=1; continue ;;
    esac
    [ "$sec" = "$want" ] || continue
    case "$line" in *=*) ;; *) die "$APPS [$want]: not key = value: $line" ;; esac
    k="${line%%=*}"; k="${k%"${k##*[![:space:]]}"}"
    v="${line#*=}"; v="${v#"${v%%[![:space:]]*}"}"
    case "$k" in
      exec) DEF_EXEC="$v" ;;
      args) read -r -a DEF_ARGS <<<"$v" ;;
      profile) DEF_PROFILE="$v" ;;
      prefs) DEF_PREFS="$v" ;;
      titlebar) DEF_TITLEBAR="$v" ;;
      desktop) DEF_DESKTOP="$v" ;;
      gpu) DEF_GPU="$v" ;;
      env) DEF_ENV+=("$v") ;;
      *) die "$APPS [$want]: no key $k" ;;
    esac
  done <"$APPS"
  [ -n "$found" ] || die "no application $want on this host"
  case "$DEF_EXEC" in
    /*) ;;
    *) die "$APPS [$want]: exec must be an absolute path" ;;
  esac
  [[ "$DEF_EXEC" != *[[:space:]]* ]] && [ -x "$DEF_EXEC" ] && [ ! -d "$DEF_EXEC" ] \
    || die "$APPS [$want]: $DEF_EXEC is not an executable"
  if [ -n "$DEF_PROFILE" ]; then
    case "$DEF_PROFILE" in
      "$HOME"/.wc-launch/*) ;;
      *) die "$APPS [$want]: profile must be a directory under $HOME/.wc-launch" ;;
    esac
    [[ "${DEF_PROFILE#"$HOME"/.wc-launch/}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [[ "$DEF_PROFILE" != *..* ]] \
      || die "$APPS [$want]: profile must be one plain directory name under $HOME/.wc-launch"
  fi
  case "$DEF_TITLEBAR" in tabs|mac-tabs|none|server|client) ;; *) die "$APPS [$want]: titlebar is tabs, mac-tabs, none or client" ;; esac
  case "$DEF_GPU" in on|off) ;; *) die "$APPS [$want]: gpu is on or off" ;; esac
  ( check_app "$DEF_DESKTOP" ) 2>/dev/null || die "$APPS [$want]: desktop $DEF_DESKTOP is not a desktop id"
  local e
  for e in "${DEF_ENV[@]}"; do
    [[ "$e" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "$APPS [$want]: env is NAME=value, not $e"
  done
}

# launch KIND ID APP ARG DPI CAPTION -- `run` (ARG empty), `action` (ARG an
# action id) and `open` (ARG a URL), §94.
#
# The argv is built here, as an array, from $APPS and -- for an action or a URL
# -- from the application's own desktop entry through `wc-proxy desktop`, which
# refuses an action the entry does not list, a URL that is not http(s)/file,
# and an argument that is not one word (security-model.md R33). Nothing the
# guest sent is a program, an option or a path: APP is a section name, ARG is
# an id or a URL that lands in the slot the entry's `%u` marks, and DPI and
# CAPTION are numbers the renderer turns into style sheets.
launch() {
  local KIND="$1" ID="$2" APP="$3" ARG="$4" DPI="$5" CAPTION="$6"
  check_id "$ID"; check_app "$APP"; check_metrics "$DPI" "$CAPTION"
  D=$(dir_of "$ID")
  [ -S "$D/wl-proxy" ] || die "no session $ID"
  load_app "$APP"
  EXE="$DEF_EXEC"
  CMDV=("$EXE")
  [ -n "$DEF_PROFILE" ] && CMDV+=(--profile "$DEF_PROFILE")
  CMDV+=("${DEF_ARGS[@]}")
  if [ "$KIND" != run ]; then
    local OUT PROG ARGS EARGS
    [ -x "$BIN/wc-proxy" ] || die "no $BIN/wc-proxy"
    # The options first: `wc-proxy desktop` reads none after its first word,
    # so the id and the URL can only ever be words (§94).
    # §106: in a session with host integration, a file:/// URL from the host
    # opens only inside the shares the host told the proxy about
    # ($D/hostint/roots, written by the proxy; empty until it has been told,
    # which refuses every file URL).
    local ROOTARGS=()
    [ -f "$D/hostint/roots" ] && ROOTARGS=(--file-roots "$(tr '\n' ':' <"$D/hostint/roots")")
    OUT=$("$BIN/wc-proxy" desktop --dirs "$(app_dirs "$EXE")" "${ROOTARGS[@]}" "$KIND" "$DEF_DESKTOP" "$ARG" 2>&1) \
      || die "$KIND $APP: $OUT"
    PROG=$(sed -n 's/^program //p' <<<"$OUT"); ARGS=$(sed -n 's/^args //p' <<<"$OUT")
    [ "$(basename "$EXE")" = "$PROG" ] \
      || die "$KIND: $APP runs $(basename "$EXE") and $DEF_DESKTOP.desktop runs $PROG"
    # One word per argument is wc-proxy's guarantee (`desktop::safe_arg`), and
    # `read -a` does no pathname expansion: a URL's `?` and `[` stay characters.
    read -r -a EARGS <<<"$ARGS"
    CMDV+=("${EARGS[@]}")
  fi
  start_app "$ID" "$DPI" "$CAPTION"
}
# ------------------------------------------------------------------- AUDIO ---
# docs/waycompose-design.md §86. Where Firefox's sound goes.
#
# On testhost the speakers belong to the VM: QEMU's emulated HDA plays
# through ALSA `hw:0,0` directly, the host has no PipeWire or Pulse, and the
# guest's own audio is what the person at the laptop hears. So the route is
# *into the guest*: each session gets its own PulseAudio with one null sink,
# Firefox finds it at `$XDG_RUNTIME_DIR/pulse/native` with no configuration
# (that is libpulse's default path and `run` already gives Firefox `$D/xdg`),
# and the sink's monitor is served as raw PCM on `$D/audio.sock`, which the
# guest's launcher reaches through the tunnel it already holds (`-L
# 127.0.0.1:<audio-port>:$D/audio.sock`) and plays with waveOut. The `audio`
# verb streams the same PCM on stdout, for a person diagnosing: ssh.exe writing
# into a pipe the launcher created delivered nothing (§86).
#
# A null sink consumes in real time whether or not anybody is listening, so
# Firefox's audio clock runs and its main thread never waits on a server that
# is not there — the stall docs/design.md §0.28.9 measured. If no server could be
# started at all, `run` sets `media.cubeb.force_null_context` instead, which is
# Firefox's own "no audio" switch, and says so loudly. There is no third state.
#
# Fixed format, because both ends are ours: s16le, 48 kHz, stereo.
AUDIO_RATE=48000
pulse_bin() {
  # 1. `$BIN/pulse`, a GC-rooted link to the package the deploy step chose;
  # 2. this machine's own, by `resolve_exec`;
  # 3. the newest pulseaudio package in the store, which is where pactl is
  #    (§106.3: a host whose own sound server is PipeWire has no other).
  if [ -x "$BIN/pulse/bin/$1" ]; then echo "$BIN/pulse/bin/$1"; return 0; fi
  resolve_exec "$1" || store_tool pulseaudio "$1"
}

# audio_up D ID: start the session's PulseAudio as a user unit beside the
# proxy's. Never fatal: a session without sound is still a session. What
# happened is left in $D/audio.state, which `run` and `audio` read.
audio_up() {
  local D="$1" ID="$2" PA UNIT="wc-launch-audio-$2"
  if [ "${WC_LAUNCH_AUDIO:-on}" = off ]; then
    echo "none: switched off on this host (WC_LAUNCH_AUDIO=off)" >"$D/audio.state"; return 0
  fi
  # §103.16: WC_LAUNCH_AUDIO=system. No server of the session's own: its
  # applications use this user's PipeWire or PulseAudio and its default sink,
  # and a sound ring adds the device side's devices to that server (and
  # `down` takes them away again).
  if [ "${WC_LAUNCH_AUDIO:-on}" = system ]; then
    local SRV="/run/user/$UID_/pulse/native"
    if [ -S "$SRV" ]; then
      echo "system $SRV (this user's own server and its default sink)" >"$D/audio.state"
    else
      echo "none: WC_LAUNCH_AUDIO=system and no server at $SRV" >"$D/audio.state"
    fi
    return 0
  fi
  # §106: a PipeWire for the host's devices, the session's own or the
  # desktop user's (pw_up, below). `on` stays §86's PulseAudio.
  case "${WC_LAUNCH_AUDIO:-on}" in
    pipewire|user-pipewire) pw_up "$D" "$ID"; return 0 ;;
  esac
  if ! PA=$(pulse_bin pulseaudio); then
    echo "none: no pulseaudio on this host (no $BIN/pulse, none in the store)" >"$D/audio.state"; return 0
  fi
  mkdir -p "$D/xdg/pulse" "$D/pulse-state" "$D/pulse-home"
  {
    echo '#!/usr/bin/env bash'
    printf 'export HOME=%q PULSE_RUNTIME_PATH=%q PULSE_STATE_PATH=%q\n' "$D/pulse-home" "$D/xdg/pulse" "$D/pulse-state"
    # §103.8: no session bus. A PulseAudio claims org.PulseAudio1 on it, so a
    # second session running at the same time (macOS runs one per application)
    # failed with "D-Bus name org.PulseAudio1 already taken" and had no sound.
    # The null sink and the monitor socket need no D-Bus at all.
    # §105: and not unset but pointed nowhere: unset, libdbus falls back to
    # $XDG_RUNTIME_DIR/bus, which a user unit has, and the second PulseAudio
    # on that bus still lost the name (seen with another program's server).
    echo 'export DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent/wc-no-bus'
    printf 'exec %q -n --daemonize=no --use-pid-file=no --system=no --exit-idle-time=-1 --log-target=stderr \\\n' "$PA"
    # §103.16: WC_LAUNCH_AUDIO_NULL_SINK=off leaves the null sink and its
    # monitor out: a sound ring's devices are then the session's only ones.
    if [ "${WC_LAUNCH_AUDIO_NULL_SINK:-on}" != off ]; then
      printf '  -L %q \\\n' "module-null-sink sink_name=wc rate=$AUDIO_RATE channels=2 format=s16le sink_properties=device.description=waycompose"
      # The guest's end: raw PCM of the monitor to whoever connects, which is
      # the launcher's tunnel (`-L 127.0.0.1:<audio-port>:$D/audio.sock`).
      printf '  -L %q \\\n' "module-simple-protocol-unix socket=$D/audio.sock record=true playback=false source=wc.monitor rate=$AUDIO_RATE channels=2 format=s16le"
    fi
    # A sound ring's pipe sinks are paced by their reader; an idle one is
    # suspended rather than streaming silence across the ring.
    printf '  -L %q \\\n' "module-suspend-on-idle timeout=2"
    printf '  -L %q >%q 2>&1\n' "module-native-protocol-unix socket=$D/xdg/pulse/native auth-anonymous=1" "$D/pulse.log"
  } >"$D/pulse.sh"
  chmod 755 "$D/pulse.sh"
  export XDG_RUNTIME_DIR="/run/user/$UID_"
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  if ! systemd-run --user --unit="$UNIT" --collect "$(command -v bash)" "$D/pulse.sh" >/dev/null 2>&1; then
    echo "none: systemd-run --user could not start $UNIT" >"$D/audio.state"; return 0
  fi
  local NULLSINK=1
  [ "${WC_LAUNCH_AUDIO_NULL_SINK:-on}" = off ] && NULLSINK=""
  for _ in $(seq 1 500); do [ -S "$D/xdg/pulse/native" ] && { [ -z "$NULLSINK" ] || [ -S "$D/audio.sock" ]; } && break; sleep 0.01; done
  if [ -S "$D/xdg/pulse/native" ] && [ -z "$NULLSINK" ]; then
    echo "pulse $D/xdg/pulse/native (no null sink: the sound ring's devices only)" >"$D/audio.state"
  elif [ -S "$D/xdg/pulse/native" ] && [ -S "$D/audio.sock" ]; then
    echo "pulse $D/xdg/pulse/native (null sink wc, s16le ${AUDIO_RATE} Hz stereo; monitor on $D/audio.sock)" >"$D/audio.state"
  else
    echo "none: $PA did not open its socket: $(tail -2 "$D/pulse.log" 2>/dev/null | tr '\n' ' ')" >"$D/audio.state"
  fi
}

# ---------------------------------------------------------------- PIPEWIRE ---
# docs/waycompose-design.md §106.3, §103.16. The host's audio devices arrive
# on the sound ring, one stream each, and wc-proxy (sound.rs) makes each a pipe
# sink or source with `pactl` on the session's pulse server, and follows the
# host's defaults with set-default-sink/source. Two servers besides §86's
# PulseAudio (`on`, still the default) and `system`:
#
#   WC_LAUNCH_AUDIO=pipewire       a PRIVATE pipewire, wireplumber and
#       pipewire-pulse for this session, as the user unit wc-launch-audio-ID,
#       everything under $D/pw: its socket $D/pw/pipewire-0, its state, its
#       configuration. The pulse socket is $D/xdg/pulse/native, where §86's
#       was, so an application finds it with no configuration and the sound
#       ring's pactl drives it like the session's PulseAudio. WirePlumber runs
#       a profile with no ALSA, Bluetooth, camera, D-Bus, logind or device
#       reservation, so it can never claim this machine's own sound hardware
#       or ask the user's desktop PipeWire to release a card. This is the mode
#       for a machine whose user has a desktop PipeWire of their own (the
#       workstation): their daemon is never touched, no node is added to it
#       and none of its defaults change. One null sink, `wc`, gives the
#       applications an output before the host's devices arrive.
#   WC_LAUNCH_AUDIO=user-pipewire  the session user's OWN PipeWire, like
#       `system` (/run/user/UID/pulse/native, the sound ring's devices added
#       to it and unloaded by `down`), for a user whose desktop IS the session
#       (a dedicated Linux VM's user). Refused unless the session user is
#       WC_LAUNCH_AUDIO_USER, ConditionUser-style: a mistake in this setting
#       would otherwise put the host's devices into somebody's real desktop.
#
# The binaries, like pulse_bin: `$BIN/pipewire` and `$BIN/wireplumber`
# (GC-rooted links the deploy step chose), then PATH, then the store.
pw_bin() { store_tool pipewire "$1"; }
# §106.3: the sound ring's native nodes under PipeWire (nix/wc-pw-node.nix):
# `$BIN/wc-pw-node`, the GC root the deploy step makes, then the store.
pw_node_bin() {
  if [ -x "$BIN/wc-pw-node/bin/wc-pw-node" ]; then echo "$BIN/wc-pw-node/bin/wc-pw-node"; return 0; fi
  store_tool wc-pw-node wc-pw-node
}
wp_bin() {
  if [ -x "$BIN/wireplumber/bin/wireplumber" ]; then echo "$BIN/wireplumber/bin/wireplumber"; return 0; fi
  store_tool wireplumber wireplumber
}
# pw_remote D: the session's PipeWire socket for the configured mode, or
# nothing (and status 1) if the mode has none.
pw_remote() {
  case "${WC_LAUNCH_AUDIO:-on}" in
    pipewire) echo "$1/pw/pipewire-0" ;;
    user-pipewire) [ "$(id -un)" = "${WC_LAUNCH_AUDIO_USER:-}" ] && echo "/run/user/$UID_/pipewire-0" || return 1 ;;
    *) return 1 ;;
  esac
}

# pw_stack_write D: write the private stack's configuration and
# $D/pipewire.sh, which runs it in the foreground until one of its processes
# ends. Prints why on stdout and fails if a binary is missing.
pw_stack_write() {
  local D="$1" PWX WPX PW="$1/pw"
  PWX=$(pw_bin pipewire) || { echo "no pipewire on this host (no $BIN/pipewire, none in the store)"; return 1; }
  WPX=$(wp_bin) || { echo "no wireplumber on this host"; return 1; }
  mkdir -p "$PW/home" "$PW/state" "$PW/config/wireplumber/wireplumber.conf.d" "$D/xdg/pulse"
  chmod 700 "$PW"
  local SPA='context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}'
  # The daemon: the stock one without portal, X11 bell or D-Bus, and with one
  # null sink so an application has an output before the host's devices
  # arrive (and with none at all from the host).
  cat >"$PW/wc-daemon.conf" <<EOF
# Generated by wc-session (§106.3). The session's private PipeWire.
context.properties = {
    core.daemon = true
    core.name = pipewire-0
    support.dbus = false
    default.clock.rate = 48000
    default.clock.allowed-rates = [ 44100 48000 ]
    mem.warn-mlock = false
    log.level = 2
}
$SPA
context.modules = [
    { name = libpipewire-module-rt args = { nice.level = -11 rtportal.enabled = false } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-metadata }
    { name = libpipewire-module-spa-device-factory }
    { name = libpipewire-module-spa-node-factory }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-client-device }
    # Grants a client its permissions: without it no client is ever answered.
    { name = libpipewire-module-access args = { } }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-link-factory }
    { name = libpipewire-module-session-manager }
]
context.objects = [
    { factory = spa-node-factory args = { factory.name = support.node.driver node.name = Dummy-Driver
        node.group = pipewire.dummy node.sync-group = sync.dummy priority.driver = 200000 } }
    { factory = spa-node-factory args = { factory.name = support.node.driver node.name = Freewheel-Driver
        priority.driver = 190000 node.group = pipewire.freewheel node.sync-group = sync.dummy node.freewheel = true } }
    { factory = adapter args = { factory.name = support.null-audio-sink node.name = wc
        node.description = "waycompose" media.class = Audio/Sink audio.position = [ FL FR ] audio.rate = 48000
        monitor.channel-volumes = true priority.session = 100 object.linger = true } }
]
EOF
  cat >"$PW/wc-pulse.conf" <<EOF
# Generated by wc-session (§106.3). pipewire-pulse for the session's
# applications and for the sound ring's pactl.
context.properties = { support.dbus = false log.level = 2 }
$SPA
context.modules = [
    { name = libpipewire-module-rt args = { nice.level = -11 rtportal.enabled = false } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-metadata }
    { name = libpipewire-module-protocol-pulse args = { } }
]
pulse.properties = { server.address = [ "unix:$D/xdg/pulse/native" ] }
EOF
  # WirePlumber's policy and metadata only: no hardware monitor of any kind.
  cat >"$PW/config/wireplumber/wireplumber.conf.d/wc-session.conf" <<'EOF'
# Generated by wc-session (§106.3). Policy only: this WirePlumber never touches
# this machine's sound hardware, its D-Bus or its seat.
wireplumber.profiles = {
  wc-session = {
    inherits = [ policy, mixin.systemwide-session ]
    support.dbus = disabled
    support.reserve-device = disabled
    monitor.alsa = disabled
    monitor.alsa-midi = disabled
    monitor.bluez = disabled
    monitor.bluez-midi = disabled
    monitor.v4l2 = disabled
    monitor.libcamera = disabled
  }
}
EOF
  {
    echo '#!/usr/bin/env bash'
    echo 'set -u'
    printf 'D=%q PW=%q PWX=%q WPX=%q\n' "$D" "$PW" "$PWX" "$WPX"
    cat <<'EOF'
# Nothing inherited may point at another PipeWire, PulseAudio or bus.
unset DBUS_SESSION_BUS_ADDRESS PIPEWIRE_REMOTE PIPEWIRE_CORE PULSE_SERVER PULSE_RUNTIME_PATH
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent
export HOME="$PW/home" XDG_STATE_HOME="$PW/state" XDG_CONFIG_HOME="$PW/config"
export XDG_RUNTIME_DIR="$PW" PIPEWIRE_RUNTIME_DIR="$PW"
pids=()
trap 'kill "${pids[@]}" 2>/dev/null; wait 2>/dev/null' EXIT
trap 'exit 0' TERM INT
rm -f "$PW/pipewire-0" "$PW/pipewire-0.lock" "$PW/pipewire-0-manager" "$PW/pipewire-0-manager.lock" "$D/xdg/pulse/native"
"$PWX" -c "$PW/wc-daemon.conf" >>"$PW/daemon.log" 2>&1 & pids+=($!)
for _ in $(seq 1 100); do [ -S "$PW/pipewire-0" ] && break; sleep 0.05; done
[ -S "$PW/pipewire-0" ] || { echo "no PipeWire socket at $PW/pipewire-0" >&2; exit 1; }
"$WPX" -p wc-session >>"$PW/wireplumber.log" 2>&1 & pids+=($!)
"$PWX" -c "$PW/wc-pulse.conf" >>"$PW/pulse.log" 2>&1 & pids+=($!)
wait -n
echo "a process of the stack ended; stopping the rest" >&2
exit 1
EOF
  } >"$D/pipewire.sh"
  chmod 755 "$D/pipewire.sh"
}

# pw_up D ID: the §106.3 modes' audio_up. Never fatal, like audio_up.
pw_up() {
  local D="$1" ID="$2" UNIT="wc-launch-audio-$2" WHY SOCK
  if [ "$WC_LAUNCH_AUDIO" = user-pipewire ]; then
    if [ -z "${WC_LAUNCH_AUDIO_USER:-}" ] || [ "$(id -un)" != "$WC_LAUNCH_AUDIO_USER" ]; then
      echo "none: WC_LAUNCH_AUDIO=user-pipewire is only for the desktop user WC_LAUNCH_AUDIO_USER (${WC_LAUNCH_AUDIO_USER:-unset}), not $(id -un)" >"$D/audio.state"
      return 0
    fi
    SOCK="/run/user/$UID_/pulse/native"
    if [ -S "$SOCK" ]; then
      echo "user-pipewire $SOCK (the desktop user's own PipeWire; the sound ring's devices are added to it)" >"$D/audio.state"
    else
      echo "none: WC_LAUNCH_AUDIO=user-pipewire and no pulse server at $SOCK" >"$D/audio.state"
    fi
    return 0
  fi
  if ! WHY=$(pw_stack_write "$D"); then
    echo "none: $WHY" >"$D/audio.state"; return 0
  fi
  export XDG_RUNTIME_DIR="/run/user/$UID_"
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  if ! systemd-run --user --unit="$UNIT" --collect "$(command -v bash)" "$D/pipewire.sh" >/dev/null 2>&1; then
    echo "none: systemd-run --user could not start $UNIT" >"$D/audio.state"; return 0
  fi
  SOCK="$D/xdg/pulse/native"
  for _ in $(seq 1 100); do [ -S "$SOCK" ] && break; sleep 0.05; done
  if [ -S "$SOCK" ]; then
    echo "pipewire $SOCK (private PipeWire $D/pw/pipewire-0; the sound ring's devices are its sinks and sources)" >"$D/audio.state"
  else
    echo "none: the private PipeWire did not come up: $(tail -2 "$D/pw/daemon.log" "$D/pw/pulse.log" 2>/dev/null | tr '\n' ' ')" >"$D/audio.state"
  fi
}

# §106.4. Host integration for the session's applications, when the proxy
# serves it ($D/hostint.sock): xdg-open is wc-host-open, BROWSER is xdg-open,
# and the host's applications and defaults come first in the XDG directories.
# Sets HOSTINT_ENV (an array of NAME=value).
hostint_env() {
  local D="$1" SHIM
  HOSTINT_ENV=()
  [ -S "$D/hostint.sock" ] || return 0
  # The shim: the deployed scripts/wc-hostint, or one written here.
  SHIM="$BASE/wc-hostint"
  if [ ! -x "$SHIM/xdg-open" ]; then
    SHIM="$D/hostint/bin"
    mkdir -p "$SHIM"
    printf '#!/bin/sh\n# wc-session (§106.4): xdg-open opens on the host.\nexec "${WC_HOST_OPEN:-wc-host-open}" "$@"\n' >"$SHIM/xdg-open"
    chmod 755 "$SHIM/xdg-open"
  fi
  HOSTINT_ENV=(
    "PATH=$SHIM:$PATH"
    "XDG_DATA_DIRS=$D/hostint/xdg-data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    "XDG_CONFIG_DIRS=$D/hostint/xdg-config:${XDG_CONFIG_DIRS:-/etc/xdg}"
    "BROWSER=xdg-open"
    "WC_HOSTINT_SOCK=$D/hostint.sock"
    "WC_HOST_OPEN=$BIN/wc-host-open"
  )
}

# hostint_args D: the proxy's §106 flags, for a session with rings.
hostint_args() {
  local D="$1"
  printf -- '--hostint %q --hostint-opener %q' "$D" "$BIN/wc-host-open"
}

# sound_ring_args D PREFIX: the proxy's §103.16 flags for the session's server,
# with the device side's platform ("mac", "win") as the node names' prefix
# (§106.3). Under PipeWire every device is a native node of wc-pw-node, paced
# by the ring's credit (a pipe module there drops); the proxy asks the server
# what it is and uses the pipe modules on a PulseAudio. Nothing without pactl.
sound_ring_args() {
  # KIND (optional): the server the session will have, when it is still
  # starting beside the proxy (§105.13); otherwise audio.state says.
  local D="$1" PREFIX="$2" KIND="${3:-}" GIVEN="${3:-}" PACTL PWNODE PWSOCK SRV
  PACTL=$(pulse_bin pactl 2>/dev/null) || return 0
  [ -n "$PACTL" ] || return 0
  [ -n "$KIND" ] || KIND=$(cut -d" " -f1 "$D/audio.state" 2>/dev/null)
  case "$KIND" in
    pulse|pipewire) SRV="unix:$D/xdg/pulse/native" ;;
    system|user-pipewire) SRV="unix:/run/user/$UID_/pulse/native" ;;
    *) return 0 ;;
  esac
  printf -- '--sound-pactl %q --sound-server %q --sound-dir %q --sound-prefix %q' "$PACTL" "$SRV" "$D" "$PREFIX"
  PWNODE=$(pw_node_bin 2>/dev/null)
  case "$KIND" in
    pipewire) PWSOCK="$D/pw/pipewire-0" ;;
    system|user-pipewire) PWSOCK="/run/user/$UID_/pipewire-0" ;;
    *) PWSOCK="" ;;
  esac
  # The socket may not exist yet when the server starts beside the proxy;
  # the proxy asks the server what it is when the first device arrives.
  [ -n "$PWNODE" ] && [ -n "$PWSOCK" ] && { [ -n "$GIVEN" ] || [ -S "$PWSOCK" ]; } \
    && printf -- ' --sound-pw-node %q --sound-pipewire %q' "$PWNODE" "$PWSOCK"
  return 0
}

# --------------------------------------------------------------- start_app ---
# start_app ID DPI CAPTION: one Wayland client, against the session's proxy,
# with the argv `launch` built in CMDV from the definition `load_app` read
# (§94). D is the session's directory and EXE the application's executable.
#
# The environment is §17.7's, minus the root: `env -u DISPLAY` because with an X
# server reachable MOZ_ENABLE_WAYLAND is a *preference* and Firefox will quietly
# use X11 instead, and an absolute WAYLAND_DISPLAY because the socket and the
# runtime directory are separate here (libwayland takes a leading '/' as a path).
# DBUS is passed so that a second launch reaches the first one's instance
# instead of colliding on its profile lock -- which is what a second click on a
# Windows application does too.
start_app() {
  local ID="$1" DPI="$2" CAPTION="$3" R RO TITLEBAR PROFILE="$DEF_PROFILE"
  # An application's data directory, created on demand -- and *only* under this
  # launcher's own tree (`load_app` refuses any other).
  #
  # It is here because the first run of the shortcut produced a window in 680 ms
  # and the window said **"Your Firefox profile cannot be loaded"**: `--profile`
  # names a directory Firefox will not create, and a modal dialog is a mapped
  # toplevel like any other. Every number in that run was real and measured the
  # wrong window, which is why §28 has a photograph next to every one of them.
  [ -n "$PROFILE" ] && mkdir -p "$PROFILE" 2>/dev/null

  # WHAT THE DEFINITION RENDERS TO (§94): user.js from `prefs` and `titlebar`,
  # and for `tabs` the userChrome.css and the GTK sheet sized from the guest's
  # DPI and caption height. By `wc-launch --render-app-files`, which is the
  # launcher's own tested renderer (`plan::host_files`) built for this machine:
  # until §94 the guest rendered these and sent them as text, and a key that
  # sends a user.js is a key that sets any preference of the profile.
  [ -x "$BIN/wc-launch" ] || die "no $BIN/wc-launch (the profile renderer, §94; the deploy step copies it)"
  R=$(mktemp -d "$D/render-XXXXXX") || die "mktemp in $D"
  RO=$("$BIN/wc-launch" --render-app-files "$DEF_TITLEBAR" "$DPI" "$CAPTION" "$R" "$DEF_PREFS" 2>&1) \
    || { rm -rf "$R"; die "render: $RO"; }
  TITLEBAR=$(sed -n 's/^moz-env //p' <<<"$RO")

  # THE PREFERENCES THE DEPLOYMENT SETS, RE-APPLIED ON EVERY START.
  #
  # `user.js` rather than a one-off edit of `prefs.js`, because "the deployment
  # says so" has to survive the user changing it in the UI and the application
  # writing its settings back out. The file is rendered by `wc_launch::plan::
  # user_js`, where it is tested; nothing here parses it.
  #
  # The one that made this necessary is `middlemouse.paste=false`: on Linux a
  # middle click pastes the primary selection, and this window is on a Windows
  # desktop where a middle click does not — which is a difference between the two
  # sides that no protocol expresses and only the deployment can settle.
  #
  # Written **only** under this launcher's own tree, so a profile somewhere else
  # is never touched.

  # THE FORWARDED GPU, IF THIS HOST HAS ONE. shared_vulkan's docs/design.md §0.28.
  #
  # `$BASE/gpu.env` is this host's statement that the guest's GPU is reachable
  # through sv-icd: `NAME=value` lines, put in front of the application exactly
  # as written (no shell ever sees them). Typically the five that make Mesa run
  # Zink on the forwarded device and present it to a `wl_shm`-only proxy:
  #
  #   MESA_LOADER_DRIVER_OVERRIDE=zink
  #   LIBGL_KOPPER_DRI2=1
  #   __EGL_VENDOR_LIBRARY_FILENAMES=<mesa-kopper-wayland>/share/glvnd/egl_vendor.d/50_mesa.json
  #   VK_DRIVER_FILES=<dir>/sv_icd.json
  #   SV_SOCKET=<the GPU side's socket>
  #
  # It is a file here and not a word from the guest because only this machine
  # knows whether those paths exist; a guest that asked for acceleration from a
  # host without it would get a Firefox that cannot start its renderer.
  #
  # **And the profile gets `gfx.webrender.all` with it, never without it.**
  # Firefox decides software or hardware WebRender from one fact: whether Mesa's
  # EGL device says `EGL_MESA_device_software`. With no DRM node on this host
  # Mesa has only its software device to give, so Firefox files Zink-on-a-GPU
  # as `mesa/software-unknown` and blocklists hardware WebRender
  # (FEATURE_FAILURE_SOFTWARE_GL). The pref overrides exactly that entry. Set
  # without the GPU it would put hardware WebRender on llvmpipe, which is slower
  # than the software WebRender Firefox would otherwise choose, so the two go
  # together or not at all.
  #
  # §94: and only for an application whose definition does not say `gpu = off`.
  GPUENV=()
  if [ "$DEF_GPU" = on ] && [ -f "$BASE/gpu.env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        ''|'#'*) ;;
        [A-Za-z_]*=*)
          case "${line%%=*}" in *[!A-Za-z0-9_]*) die "gpu.env: bad name in: $line" ;; esac
          GPUENV+=("$line") ;;
        *) die "gpu.env: not NAME=value: $line" ;;
      esac
    done <"$BASE/gpu.env"
  fi

  # THE GPU IS PER SESSION, NOT PER HOST (§86). gpu.env says how to reach a
  # forwarded GPU; whether *this* session has one is whether `gpu` made
  # $D/icd.sock. Without it the GPU environment is not applied at all: forcing
  # Zink with nothing behind it is a Firefox whose renderer cannot start, and
  # software WebRender is what it should get instead. Said loudly.
  GPU_ON=""
  if [ ${#GPUENV[@]} -gt 0 ]; then
    if [ -S "$D/icd.sock" ]; then
      GPUENV+=("SV_SOCKET=$D/icd.sock")
      # The doorbell (§87): every ICD shares the one port through the hub
      # `gpu` started, if the port was there to hold.
      if [ -s "$D/bell.path" ]; then
        GPUENV+=("SV_BELL=$(cat "$D/bell.path")")
      elif [ -S "$D/bell.sock" ]; then
        GPUENV+=("SV_BELL=$D/bell.sock")
      fi
      # §100: the ICD's Wayland present finishes after vkQueuePresentKHR only
      # with libsv_wlshim.so preloaded (it guards the application's surface);
      # without it the ICD presents inside the call, correct but slower.
      if [ -f "$BASE/bin/libsv_wlshim.so" ]; then
        GPUENV+=("LD_PRELOAD=$BASE/bin/libsv_wlshim.so${LD_PRELOAD:+:$LD_PRELOAD}")
      fi
      GPU_ON=1
    else
      echo "wc-session: NO GPU for $ID -- $BASE/gpu.env is set and this session has no GPU sessions ($D/icd.sock); Firefox renders in software" | tee -a "$D/app.log" >&2
      GPUENV=()
    fi
  fi
  # THE RENDER NODE (§112). With a GPU and this installation's dma-buf node
  # (`$BASE/dmabuf-node`, the userspace render node `sv-drm serve` provides),
  # the application runs inside `sv-drm ns`, where libdrm sees that node as
  # the GPU's render node -- a PCI device of the guest GPU's ids from
  # `$BASE/gpu-pci` -- and the ICD hands out its frames as dma-bufs naming
  # sections (SV_DRM_NODE). The application is stock and keeps its defaults:
  # Firefox finds a hardware EGL device and chooses hardware WebRender and
  # VA-API decode itself, inside its own sandbox, which reaches the GPU
  # through the node as with any driver. Without a node, nothing changes.
  NSWRAP=()
  # Not for the nested desktop (§102): `atp-nested` goes through sudo, which a
  # user namespace would refuse, and its seat runs KWin in `sv-drm ns` itself.
  case "$DEF_DESKTOP" in atp-nested*) NESTED=1 ;; *) NESTED="" ;; esac
  if [ -n "$GPU_ON" ] && [ -z "$NESTED" ] && [ -n "${DMABUF_NODE:-}" ] && [ -c "$DMABUF_NODE" ]; then
    SVDRM=""
    for c in "$BASE/bin/sv-drm" "$(command -v sv-drm 2>/dev/null)"; do
      [ -n "$c" ] && [ -x "$c" ] && { SVDRM=$c; break; }
    done
    if [ -n "$SVDRM" ]; then
      NODE_DEV=$(stat -L -c '%t:%T' "$DMABUF_NODE" 2>/dev/null)
      NODE_DEV="$((16#${NODE_DEV%%:*})):$((16#${NODE_DEV##*:}))"
      NSWRAP=("$SVDRM" ns --dev "$NODE_DEV" --minor "${DMABUF_NODE##*renderD}")
      PCI=$(head -c 16 "$BASE/gpu-pci" 2>/dev/null | tr -d '[:space:]')
      [[ "$PCI" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]] && NSWRAP+=(--pci "$PCI")
      NSWRAP+=(--)
      GPUENV+=("SV_DRM_NODE=$DMABUF_NODE")
      echo "wc-session: $ID renders through the render node $DMABUF_NODE ($NODE_DEV${PCI:+, pci $PCI})" >>"$D/app.log"
    else
      echo "wc-session: NO RENDER NODE for $ID -- $DMABUF_NODE is there and sv-drm is not ($BASE/bin/sv-drm); frames are copied" | tee -a "$D/app.log" >&2
    fi
  fi
  # What `proxy` managed for this session's sound (§86). Read once, here.
  AUDIO=$(cat "$D/audio.state" 2>/dev/null || echo "none: no audio.state (a proxy from before §86)")
  case "$AUDIO" in
    pulse*|pipewire*|user-pipewire*|system*) ;;
    *)
      # Loudly, in both places a person looks: the application's log on this
      # machine and the launcher's log on the guest (it logs what `run` says).
      echo "wc-session: NO AUDIO for $ID -- $AUDIO; Firefox gets media.cubeb.force_null_context" >>"$D/app.log"
      echo "wc-session: NO AUDIO for $ID -- $AUDIO; Firefox gets media.cubeb.force_null_context" >&2
      ;;
  esac
  case "$PROFILE" in
    "$HOME"/.wc-launch/*)
      cp "$R/user.js" "$PROFILE/user.js" 2>/dev/null
      # NO "OPEN FIREFOX IN TROUBLESHOOT MODE?" (§86 item 6, §87). A launcher
      # session can end with Firefox still running -- `down`, the guest logging
      # off, the VM host's proxy going -- and Firefox counts a run that did not
      # end cleanly as a startup crash; after three in a row it puts a modal
      # dialog in front of the next start, in a window the user did not ask for
      # and on a desktop where nobody may be able to answer it. -1 turns the
      # count off. Every launcher profile, always: it is a property of how this
      # deployment ends Firefox, not of any one session.
      printf '\n// Added by wc-session: a session that ends under Firefox is not a startup crash.\nuser_pref("toolkit.startup.max_resumed_crashes", -1);\n' \
        >> "$PROFILE/user.js"
      # Only without the render node: a copying GPU path whose EGL device is
      # the software one, which Firefox would otherwise refuse (§0.28). With
      # the node Firefox decides for itself (§112).
      if [ ${#GPUENV[@]} -gt 0 ] && [ ${#NSWRAP[@]} -eq 0 ]; then
        printf '\n// Added by wc-session: this host forwards a GPU (%s).\nuser_pref("gfx.webrender.all", true);\n' "$BASE/gpu.env" \
          >> "$PROFILE/user.js"
      fi
      # AUDIO (§86): no server means Firefox's own null context, never a
      # Firefox that waits on an audio process for ever.
      case "$AUDIO" in
        pulse*|pipewire*|user-pipewire*|system*) ;;
        *)
          printf '\n// Added by wc-session: this session has no audio server (%s).\nuser_pref("media.cubeb.force_null_context", true);\n' "$AUDIO" \
            >> "$PROFILE/user.js"
          ;;
      esac
      ;;
  esac

  # WHAT THE APPLICATION IS TOLD ABOUT ITS OWN TITLE BAR -- docs/waycompose-design.md §82.
  #
  # The value of MOZ_GTK_TITLEBAR_DECORATION, and a userChrome.css or none, both
  # from the definition's `titlebar` (§94; until then the launcher sent them):
  #
  #   titlebar = tabs (the default)  ->  client, plus the userChrome.css. Firefox
  #       asks the compositor for Client; the compositor's default `auto` folds
  #       the caption of a window whose client asked for that, so Firefox's tab
  #       strip is *inside* Windows' caption, and the sheet makes the strip the
  #       caption's height and leaves the corner where Windows draws minimise,
  #       maximise and close empty. user.js turns Firefox's own three buttons off.
  #   titlebar = none (the opt-out)  ->  none, and no sheet. Windows' caption
  #       above, the tab strip below: §22's arrangement.
  #
  # None of these is carried by any protocol -- they are facts about the machine
  # the client runs on, and this is the program that starts it. A Firefox
  # started some other way gets two title bars (no env) or a chevron under
  # Windows' buttons (no sheet), and the compositor's log says which (`DRAWS
  # UNDER THE CAPTION BUTTONS`). The sheet's size is the one thing the guest
  # still decides, as the two numbers DPI and CAPTION.
  case "$TITLEBAR" in
    client|none) ;;
    *) TITLEBAR=none ;;
  esac
  case "$PROFILE" in
    "$HOME"/.wc-launch/*)
      if [ -f "$R/userChrome.css" ]; then
        mkdir -p "$PROFILE/chrome" 2>/dev/null
        cp "$R/userChrome.css" "$PROFILE/chrome/userChrome.css"
      elif head -c 40 "$PROFILE/chrome/userChrome.css" 2>/dev/null \
             | grep -qF '/* wc-launch: tabs in the title bar.'; then
        # Ours, from a previous `tabs` start: an application that opted out
        # must not keep a tab strip sized for a caption it no longer has. A
        # sheet without the mark is the user's and is left alone.
        rm -f "$PROFILE/chrome/userChrome.css"
      fi
      ;;
  esac
  # THE GTK SHEET, FOR THE DIALOGS -- docs/waycompose-design.md §91.8.
  #
  # For `tabs` the renderer wrote a gtk.css that pads every GTK header bar's end
  # by the width of Windows' caption buttons, because the compositor folds the caption
  # of GTK's dialogs (the file chooser, Save As, Print) just as it does
  # Firefox's main window, and without it the file chooser's Open button sat
  # under Windows' close button. GTK reads gtk.css and settings.ini from
  # $XDG_CONFIG_HOME/gtk-{3,4}.0 and nowhere else a launcher can reach, and the
  # user's real ~/.config is not ours to write. So the application gets a
  # session-private XDG_CONFIG_HOME that is an overlay of the real one: every
  # entry of it is a symbolic link back to the user's, so user-dirs.dirs, the
  # file chooser's bookmarks, dconf (the icon theme), fontconfig, mimeapps.list
  # and ~/.config/mozilla behave as before -- measured: a bare private
  # directory lost the sidebar's folders and the icon theme. Only gtk.css and
  # settings.ini are replaced: gtk.css imports the user's own first, and
  # settings.ini is the user's with gtk-decoration-layout set to none, so a GTK
  # window with a header bar draws no second set of window buttons. A file an
  # application creates at the top of the directory lands in the overlay and
  # goes with the session; one written through a link lands in the user's.
  GTKCSS=""
  [ -f "$R/gtk.css" ] && GTKCSS=$(cat "$R/gtk.css")
  rm -rf "$R"
  CONFIG_ENV=()
  if [ -n "$GTKCSS" ]; then
    REAL="${XDG_CONFIG_HOME:-$HOME/.config}"
    C="$D/xdg-config"
    rm -rf "$C"; mkdir -p "$C"
    for e in "$REAL"/* "$REAL"/.[!.]*; do
      [ -e "$e" ] || [ -L "$e" ] || continue
      case "${e##*/}" in gtk-3.0|gtk-4.0) ;; *) ln -s "$e" "$C/${e##*/}" ;; esac
    done
    for v in gtk-3.0 gtk-4.0; do
      mkdir -p "$C/$v"
      for e in "$REAL/$v"/*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        case "${e##*/}" in gtk.css|settings.ini) ;; *) ln -s "$e" "$C/$v/${e##*/}" ;; esac
      done
      {
        [ -f "$REAL/$v/gtk.css" ] && printf '@import url("file://%s");\n' "$REAL/$v/gtk.css"
        printf '%s\n' "$GTKCSS"
      } > "$C/$v/gtk.css"
      {
        if [ -f "$REAL/$v/settings.ini" ]; then
          grep -v '^[[:space:]]*gtk-decoration-layout[[:space:]]*=' "$REAL/$v/settings.ini"
        else
          echo '[Settings]'
        fi
        echo 'gtk-decoration-layout=:'
      } > "$C/$v/settings.ini"
    done
    CONFIG_ENV=(XDG_CONFIG_HOME="$C")
  fi
  DBUS=""
  [ -S "/run/user/$UID_/bus" ] && DBUS="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus"
  # §95: a crash reporter that is dismissed deletes its minidump, and four of
  # §95's crashes left nothing to read. Kept in the profile's minidumps/.
  KEEP_DUMPS="MOZ_CRASHREPORTER_NO_DELETE_DUMP=1"
  # §106: the session's PipeWire by path (its sockets are not under the
  # application's XDG_RUNTIME_DIR), and host integration if the proxy serves it.
  AUDIOENV=()
  case "$AUDIO" in
    pipewire*|user-pipewire*)
      AUDIOENV=("PULSE_SERVER=unix:$(sed -n 's/^[a-z-]* \([^ ]*\) .*/\1/p' "$D/audio.state")")
      PWR=$(pw_remote "$D") && AUDIOENV+=("PIPEWIRE_REMOTE=$PWR")
      ;;
  esac
  hostint_env "$D"
  # shellcheck disable=SC2086
  # §103.16: with the user's own sound server, the applications are told
  # where it is (their runtime directory is the session's).
  PULSEENV=""
  case "$AUDIO" in system*) PULSEENV="PULSE_SERVER=unix:/run/user/$UID_/pulse/native" ;; esac
  # §106.7: TEST SESSIONS NEVER SEE THE USER'S APPLICATION STATE. An operator
  # setting of this machine (never a word from the guest): with
  # WC_LAUNCH_TEST_HOME=DIR the application gets DIR/{home,config,data,state,cache}
  # as its HOME and XDG base directories, so an editor restores no real
  # documents and a browser opens no real profile. Production sessions leave it
  # unset: there the application is the user's, with the user's state.
  TESTENV=()
  # The same setting for one installation only: `$BASE/test-home` (its first
  # line), written by the operator beside this script, for a test
  # installation started by the shared session service, whose environment
  # every installation shares.
  if [ -z "${WC_LAUNCH_TEST_HOME:-}" ] && [ -s "$BASE/test-home" ]; then
    WC_LAUNCH_TEST_HOME=$(head -1 "$BASE/test-home")
  fi
  if [ -n "${WC_LAUNCH_TEST_HOME:-}" ]; then
    case "$WC_LAUNCH_TEST_HOME" in /*) ;; *) die "WC_LAUNCH_TEST_HOME must be absolute" ;; esac
    [[ "$WC_LAUNCH_TEST_HOME" =~ ^[A-Za-z0-9/._-]+$ ]] || die "WC_LAUNCH_TEST_HOME: only [A-Za-z0-9/._-]"
    mkdir -p "$WC_LAUNCH_TEST_HOME"/{home,config,data,state,cache}
    TESTENV=(HOME="$WC_LAUNCH_TEST_HOME/home" XDG_CONFIG_HOME="$WC_LAUNCH_TEST_HOME/config"
      XDG_DATA_HOME="$WC_LAUNCH_TEST_HOME/data" XDG_STATE_HOME="$WC_LAUNCH_TEST_HOME/state"
      XDG_CACHE_HOME="$WC_LAUNCH_TEST_HOME/cache")
    echo "wc-session: test session: HOME and XDG_* under $WC_LAUNCH_TEST_HOME" >>"$D/app.log"
  fi
  setsid env -u DISPLAY \
    XDG_RUNTIME_DIR="$D/xdg" $PULSEENV \
    WAYLAND_DISPLAY="$D/wl-proxy" \
    MOZ_ENABLE_WAYLAND=1 GDK_BACKEND=wayland \
    MOZ_GTK_TITLEBAR_DECORATION="$TITLEBAR" $DBUS $KEEP_DUMPS \
    "${AUDIOENV[@]}" "${HOSTINT_ENV[@]}" \
    "${CONFIG_ENV[@]}" \
    "${GPUENV[@]}" \
    "${DEF_ENV[@]}" \
    "${TESTENV[@]}" \
    "${NSWRAP[@]}" "${CMDV[@]}" >>"$D/app.log" 2>&1 &
  echo "run ok $! audio=${AUDIO%%[: ]*} titlebar=$DEF_TITLEBAR"
}


# §92. THE TWO VERBS WHOSE ANSWER IS WRITTEN IN PIECES ARE SENT IN ONE.
#
# Windows' own ssh.exe, with its standard output on a file (§28.6's
# arrangement), took the first 1417 bytes of `app` and then waited for ever:
# the host had finished, nothing of ours was running on either side, and the
# MSYS ssh on the same guest received all 20520 bytes. `icon`, which prints
# its 18 KB at once, has never had the problem; `app` writes its desktop entry
# first and its task icons a rasteriser later. So `app` and `frequent` run
# again under a command substitution and their answer leaves in one write.
case "$VERB" in
  app|frequent)
    if [ -z "${WC_SESSION_BUFFERED:-}" ]; then
      OUT=$(WC_SESSION_BUFFERED=1 env -u SSH_ORIGINAL_COMMAND bash "$0" "$VERB" "$@"); RC=$?
      printf '%s\n' "$OUT"
      exit "$RC"
    fi
    ;;
esac

case "$VERB" in

ping)
  words 0 0 "no words" "$@"
  echo "wc-session ok $(hostname)"
  ;;

# ---------------------------------------------------------------------- up ---
# The locate. The guest has already pinned and stamped its arena and told us the
# run id it stamped with; this sweeps QEMU's memfd for those stamps and writes
# the plan that says where each guest page landed in the host's flat view.
#
# ~2.4 s for a 13 GiB guest (§12.5), and this is the cost the whole design is
# arranged around: it is paid once per session here, not once per launch.
up)
  words 3 5 "ID RUNID ivshmem" "$@"
  ID="${1:-}"; RUNID="${2:-}"; PAGES="${3:-}"; OUTBOUND="${4:-1048576}"
  check_id "$ID"
  # §94: `0x` and one to sixteen hex digits, on both paths. Until §94 this only
  # refused a `0x` word with a non-hex digit in it, so a run id without the
  # prefix -- `1;anything` -- passed, and the guest-RAM path below printed it
  # into the script it pipes to $ROOTC with `%s`.
  [[ "$RUNID" =~ ^0x[0-9a-fA-F]{1,16}$ ]] || die "bad run id"
  # IVSHMEM ARENA (§83). Nothing to locate: QEMU was told where the region is,
  # by a path, before the guest booted. What is left is to check that the
  # region *now* describes the compositor that asked -- magic, then run id --
  # because a header from a compositor that has exited stays in the file until
  # the next one clears it. The proxy checks the same again when it maps the
  # region; this check is here so that a wrong region fails at `up`, with the
  # reason, rather than as a proxy that never binds its socket.
  if [ "$PAGES" = ivshmem ]; then
    [ "$#" -eq 3 ] || die "up ID RUNID ivshmem takes no more words"
    D=$(dir_of "$ID")
    rm -rf "$D"; mkdir -p "$D/xdg"; chmod 700 "$D" "$D/xdg"
    [ -e "$ARENA" ] || die "no ivshmem arena at $ARENA: the VM has no wc-arena device (virtualisation.windowsVm.waycomposeArena), and there is no fallback to guest RAM"
    if [ ! -r "$ARENA" ] || [ ! -w "$ARENA" ]; then
      die "$ARENA exists and $(id -un) cannot read and write it: not in its group ($(stat -c %G "$ARENA" 2>/dev/null)), and there is no fallback to root"
    fi
    MAGIC=$(head -c 8 "$ARENA" 2>/dev/null | tr -d '\0')
    [ "$MAGIC" = WCIVSHM1 ] || die "$ARENA has no published header (magic '$MAGIC'): the compositor has not published, or has exited"
    # The u64s are little-endian and so is this machine, so od prints them as
    # numbers. Offsets are wc_handle::ivshmem's: run id 16, generation 24, length 32.
    HAVE=$(od -A n -t x8 -j 16 -N 8 "$ARENA" | tr -d ' ')
    WANT=$(printf '%016x' "$RUNID")
    [ "$HAVE" = "$WANT" ] || die "$ARENA describes run 0x$HAVE and the compositor said $RUNID: another compositor's header"
    GEN=$(od -A n -t u8 -j 24 -N 8 "$ARENA" | tr -d ' ')
    LEN=$(od -A n -t u8 -j 32 -N 8 "$ARENA" | tr -d ' ')
    printf '%s\n' "$RUNID" >"$D/arena.run"
    echo "ivshmem run $RUNID generation $GEN, $LEN bytes at $ARENA"
    # THE WAYLAND RINGS (docs/waycompose-design.md §89). A version-2 header
    # says where the compositor kept the region's tail for them (offsets 64
    # and 72); the doorbell is the rings' virtio-serial port, whose socket the
    # VM's unit made for this group as it made §87's. Both, or the session's
    # Wayland connections cross ssh as before -- said here, in capitals, and
    # again by the proxy, because a session that went back to ssh is otherwise
    # indistinguishable from one that did not until somebody measures it.
    VER=$(od -A n -t u4 -j 8 -N 4 "$ARENA" | tr -d ' ')
    RLEN=0
    [ "$VER" = 2 ] && RLEN=$(od -A n -t u8 -j 72 -N 8 "$ARENA" | tr -d ' ')
    if [ "${RLEN:-0}" = 0 ]; then
      WHY="the compositor kept no rings (header version $VER; its log says why)"
    elif wl_hub; then
      WHY=""
    elif [ ! -S "$WCBELL" ]; then
      WHY="no doorbell socket at $WCBELL: the VM has no org.sirati.wcbell.0 port"
    elif [ ! -r "$WCBELL" ] || [ ! -w "$WCBELL" ]; then
      WHY="$WCBELL exists and $(id -un) cannot use it (group $(stat -c %G "$WCBELL" 2>/dev/null))"
    else
      WHY=""
    fi
    if [ -z "$WHY" ]; then
      ROFF=$(od -A n -t u8 -j 64 -N 8 "$ARENA" | tr -d ' ')
      echo "rings" >"$D/transport"
      echo "transport rings: $RLEN bytes at $ROFF, doorbell $(wcbell_use)"
    elif [ "${WC_LAUNCH_SERVICE:-}" = 1 ] && [ "${RLEN:-0}" != 0 ]; then
      # §105: started by the session service, so there is no ssh tunnel to
      # fall back to. Rings with no doorbell are polled, said loudly; rings
      # that do not exist fail the session, closed.
      echo "rings-poll" >"$D/transport"
      echo "transport rings, NO DOORBELL ($WHY): polled every millisecond"
    elif [ "${WC_LAUNCH_SERVICE:-}" = 1 ]; then
      die "no Wayland rings in $ARENA ($WHY) and no ssh to fall back to: refusing the session (§105)"
    else
      echo "ssh: $WHY" >"$D/transport"
      echo "transport SSH FALLBACK: $WHY"
    fi
    # §107: the session's index in the guest's shared compositor, from its
    # boot record, which the session service passes; every ring claim of the
    # proxy carries it and its arena is the BAR windows it is granted.
    case "${WC_LAUNCH_SESSION_INDEX:-0}" in
      0) rm -f "$D/session.index" ;;
      [1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) echo "$WC_LAUNCH_SESSION_INDEX" >"$D/session.index"
         echo "session index $WC_LAUNCH_SESSION_INDEX of a shared compositor" ;;
      *) die "WC_LAUNCH_SESSION_INDEX=$WC_LAUNCH_SESSION_INDEX is not 0..255" ;;
    esac
    echo "up ok $D"
    exit 0
  fi
  # THE GUEST-RAM PATH RUNS AS ROOT, AND SINCE §94 ONLY WHERE THIS HOST SAYS SO.
  # Nothing of ours asks for it -- the launcher has been on ivshmem since §83
  # and the developer harnesses locate their own arena -- and it is the one
  # path by which this script's caller reaches $ROOTC. So it is refused unless
  # the environment this script runs in sets WC_LAUNCH_GUEST_RAM=1, which the
  # guest cannot do (sshd accepts no environment from it, and the forced
  # command sets none): an operator who wants it writes it into the key's
  # `command="WC_LAUNCH_GUEST_RAM=1 …/wc-session"` on purpose.
  [ "${WC_LAUNCH_GUEST_RAM:-}" = 1 ] \
    || die "the guest-RAM arena (as root) is not served on this host; the launcher's arena is ivshmem (§83, §94)"
  [[ "$PAGES" =~ ^[1-9][0-9]{0,7}$ ]] && [[ "$OUTBOUND" =~ ^[0-9]{1,12}$ ]] || die "bad page count"
  [ -z "${5:-}" ] || [ "$5" = frames ] || die "up: the fifth word is frames or nothing"
  D=$(dir_of "$ID")
  rm -rf "$D"; mkdir -p "$D/xdg"; chmod 700 "$D" "$D/xdg"
  [ -x "$BIN/wc-arena-host" ] || die "no $BIN/wc-arena-host"
  # THE FRAME LIST, WHICH ARRIVES ON STDIN AND ONLY IF ASKED FOR
  #
  # A fifth word `frames` means the guest is piping the arena's page frame list
  # down this same ssh channel. It is opt-in rather than "read stdin if there is
  # any", because a `cat` here would block for ever on the older launcher that
  # sends nothing, and a session that hangs at the locate is worse than one that
  # sweeps.
  #
  # Why it is worth a transfer: the sweep is not merely slow (2.3 s against
  # 0.064 s), it is a coin flip on a loaded guest. Five consecutive runs of the
  # test harness gave `16377 of 16384 pages` and `28 page index(es) claimed
  # twice` -- it searches 13 GiB of guest memory for stamps while the guest is
  # free to move pages under it. Translating a frame list reads no stamps at
  # all, so that whole class of failure stops being expressible.
  #
  # 16 bytes a page, so a 64 MiB arena is 256 KiB. That is why it is a pipe and
  # not an argument. What crosses is *where the guest's pages are*, never what
  # is in them: the arena is still guest RAM found in QEMU's backing object.
  FRAMES_ARG=""
  if [ "${5:-}" = frames ]; then
    cat >"$D/arena.frames"
    if [ -s "$D/arena.frames" ]; then
      FRAMES_ARG="--frames $D/arena.frames"
      echo "frames $(wc -l <"$D/arena.frames")"
    else
      echo "frames 0 (empty; sweeping instead)" >&2
    fi
  fi
  # shellcheck disable=SC2086
  printf 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin\n%q --qmp %q --vm %q --run %q --pages %q --outbound %q %s --plan %q >%q 2>&1\necho "rc=$?" >>%q\nchown %s:%s %q %q 2>/dev/null\ntrue\n' \
    "$BIN/wc-arena-host" "$QMP" "$VM_HINT" "$RUNID" "$PAGES" "$OUTBOUND" "$FRAMES_ARG" \
    "$D/arena.plan" "$D/locate.log" "$D/locate.log" \
    "$UID_" "$GID_" "$D/locate.log" "$D/arena.plan" \
    | eval "$ROOTC" >/dev/null 2>&1
  if ! grep -q '^rc=0$' "$D/locate.log" 2>/dev/null; then
    echo "wc-session: the locate failed" >&2
    sed 's/^/  /' "$D/locate.log" 2>/dev/null >&2
    exit 1
  fi
  grep -o 'located [0-9]* of [0-9]* pages[^$]*' "$D/locate.log" | tail -1
  echo "up ok $D"
  ;;

# ------------------------------------------------------------------- rings ---
# §103.14: the ring region of a guest with no shared-memory device (the macOS
# guest): a second window of its own RAM, stamped like the arena, located here
# once. Its Wayland connections, their feeds, and the session's control and
# sound then cross as shared memory; `proxy` uses the plan this writes, with no
# upstream socket. Same permission as the guest-RAM `up`, and after it (`up`
# makes the run directory).
rings)
  words 3 3 "ID RUNID PAGES" "$@"
  ID="${1:-}"; RUNID="${2:-}"; PAGES="${3:-}"
  check_id "$ID"
  [[ "$RUNID" =~ ^0x[0-9a-fA-F]{1,16}$ ]] || die "bad run id"
  [[ "$PAGES" =~ ^[1-9][0-9]{0,7}$ ]] || die "bad page count"
  [ "${WC_LAUNCH_GUEST_RAM:-}" = 1 ] || die "guest-RAM rings are not served on this host (§94)"
  D=$(dir_of "$ID")
  [ -d "$D" ] || die "no session $ID: call up first"
  printf 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin\n%q --qmp %q --vm %q --run %q --pages %q --outbound 0 --plan %q >%q 2>&1\necho "rc=$?" >>%q\ntrue\n' \
    "$BIN/wc-arena-host" "$QMP" "$VM_HINT" "$RUNID" "$PAGES" "$D/rings.plan" "$D/rings.log" "$D/rings.log" \
    | eval "$ROOTC" >/dev/null 2>&1
  if ! grep -q '^rc=0$' "$D/rings.log" 2>/dev/null; then
    echo "wc-session: the ring region was not located" >&2
    sed 's/^/  /' "$D/rings.log" 2>/dev/null >&2
    exit 1
  fi
  grep -o 'located [0-9]* of [0-9]* pages[^$]*' "$D/rings.log" | tail -1
  echo "rings ok $D/rings.plan"
  ;;

# ------------------------------------------------------------------- proxy ---
# wc-proxy, on the plan, in a root transient unit -- root because it opens the
# arena's backing object at /proc/<qemu-pid>/fd/<n>, and a transient unit rather
# than a long-lived root shell because a root call that blocks for a session's
# lifetime comes back with no output at all (testhost's rootc habits).
#
# `--arena-grow` NOW GROWS, AND THIS IS THE FLAG THAT MAKES IT.
#
# The startup region is the one that can never be given back -- it holds the
# outbound window -- so its size is a floor for the whole session and the only
# safe direction is small. `VirtualLock`ed pages are non-pageable, gone from
# Windows entirely, so a floor is not merely reserved memory.
#
# `--arena-grow` says what to do when the startup region is not enough: take
# another one instead of refusing. For four stages that was armed and inert,
# because over guest RAM the proxy's `PlanGrowth` obtains a region by re-reading
# the plan and nothing on this deployment ever appended to it.
#
# `--arena-locator` is what closed that. With it the proxy uses `GuestGrowth`
# instead: it asks the compositor for a region **over the shared memory both
# sides already map** -- sv-transport's control region and one ring, the same
# channel shared_vulkan uses across this boundary, not a socket and not a new
# mechanism -- and then runs `wc-arena-host --append --frames` to translate the
# page frame list the guest sent back into file offsets. Without the flag the
# proxy falls back to watching the plan, which is the pre-growth behaviour and
# is what an operator appending by hand still gets.
#
# QMP and the VM hint come with it because the locator needs them, and they are
# the same two values `up` uses a few lines above. Root is not an issue: this
# proxy already runs as root in a transient unit so it can open the backing
# object, so running the locator is a fork and an exec rather than a privilege
# boundary.
#
# See docs/waycompose-design.md §34.
# The socket it creates is chowned to the invoking user, so the *application*
# is not privileged. §17.7 gave the run its own root-owned home instead; this is
# the other half of the same problem and the cheaper answer, because a Firefox
# with the user's own warm profile starts in a second and a root one with a
# fresh home does not.
proxy)
  words 1 1 "ID" "$@"
  ID="${1:-}"; check_id "$ID"
  D=$(dir_of "$ID")
  # IVSHMEM ARENA (§83): this user, a user unit, no $ROOTC. The socket is made
  # by this user, so there is nothing to chown. `--arena-run` is the run id `up`
  # checked, and the proxy refuses a header carrying any other. No
  # `--arena-grow`: a BAR is the size QEMU made it, and the proxy refuses the
  # flag on this transport rather than arm growth with nothing behind it.
  #
  # A *user* unit rather than `setsid`, for the reason the root path used a
  # transient unit: it outlives this ssh exec, `down` can stop it by name, and
  # its journal is a record. It needs this user's manager to outlive logins
  # (`loginctl enable-linger`), and says so if it does not.
  if [ -f "$D/arena.run" ]; then
    # §105: started by the session service (WC_LAUNCH_SERVICE=1), the
    # session has no ssh tunnel and so no upstream socket: every connection,
    # both feeds, the control and the sound are ring slots.
    SERVICE=0
    [ "${WC_LAUNCH_SERVICE:-}" = 1 ] && SERVICE=1
    [ $SERVICE = 1 ] || [ -S "$D/up.sock" ] || die "no upstream socket for $ID -- the guest's tunnel is not up"
    # §105.13: the session's PulseAudio starts beside the proxy, not before it;
    # what it will be is known now, and the proxy only talks to it once the
    # guest's sound ring announces a device, after this verb has returned.
    APID=""
    AUDIO_EXPECT=none
    if [ $SERVICE = 1 ]; then
      audio_up "$D" "$ID" & APID=$!
      if [ "${WC_LAUNCH_AUDIO:-on}" = system ]; then AUDIO_EXPECT=system
      elif [ "${WC_LAUNCH_AUDIO:-on}" = user-pipewire ]; then AUDIO_EXPECT=user-pipewire
      elif [ "${WC_LAUNCH_AUDIO:-on}" = pipewire ] && pw_bin pipewire >/dev/null 2>&1; then AUDIO_EXPECT=pipewire
      elif [ "${WC_LAUNCH_AUDIO:-on}" != off ] && pulse_bin pulseaudio >/dev/null 2>&1; then AUDIO_EXPECT=pulse; fi
    fi
    [ -x "$BIN/wc-proxy" ] || die "no $BIN/wc-proxy"
    UNIT="wc-launch-$ID"
    RUN=$(cat "$D/arena.run")
    {
      echo '#!/usr/bin/env bash'
      echo 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin'
      # §105: this host's settings, for the wc-session the control ring runs
      # (as §103.14 does): the unit does not inherit this process's environment.
      [ $SERVICE = 1 ] && env | grep '^WC_LAUNCH_' | grep -v '^WC_LAUNCH_SERVICE=' | while IFS= read -r kv; do printf 'export %q\n' "$kv"; done
      # §88. A `WC_FRAME_TRACE=` line in gpu.env traces the proxy as well:
      # the frame timeline has a proxy half, and gpu.env is where a measured
      # run already says what the session's frame should record.
      ft=$(grep -m1 '^WC_FRAME_TRACE=' "$BASE/gpu.env" 2>/dev/null)
      [ -n "$ft" ] && printf 'export %q\n' "$ft"
      # §89: and its clock, so the proxy's half of an input timeline is on
      # the machine's monotonic counter like the compositor's.
      ft=$(grep -m1 '^WC_FRAME_TRACE_CLOCK=' "$BASE/gpu.env" 2>/dev/null)
      [ -n "$ft" ] && printf 'export %q\n' "$ft"
      printf 'rm -f %q\n' "$D/wl-proxy"
      # §89: the rings, when `up` found both them and their doorbell. The
      # tunnel's socket stays the upstream either way: the icon and clipboard
      # feeds use it, and so does a connection that cannot have a ring.
      RINGARGS=""
      UPARGS=$(printf -- '--upstream %q' "$D/up.sock")
      [ "$(cat "$D/transport" 2>/dev/null)" = rings ] \
        && RINGARGS=$(printf -- '--wayland-rings --wayland-bell %q' "$(wcbell_use)")
      if [ $SERVICE = 1 ]; then
        UPARGS=""
        BELLUSE=poll
        [ "$(cat "$D/transport" 2>/dev/null)" = rings ] && BELLUSE=$(wcbell_use)
        RINGARGS=$(printf -- '--wayland-rings --wayland-bell %q --session-control %q --session-id %q' "$BELLUSE" "$BASE/wc-session" "$ID")
        # §107: a session of the guest's shared compositor.
        IDX=$(cat "$D/session.index" 2>/dev/null)
        [ -n "$IDX" ] && RINGARGS="$RINGARGS --session-index $IDX"
        # §110: the GPU device is region 1 of the one pool the shared
        # compositor leases Wayland buffers from when its BAR is full.
        [ -n "$IDX" ] && [ -r "$GPUREGION" ] && RINGARGS="$RINGARGS $(printf -- '--arena-region 1=%q' "$GPUREGION")"
        # §106: host integration, and every Windows endpoint a stream of the
        # sound ring with stable names (§103.16, §106.3).
        # The session's server starts beside the proxy (§105.13), so its kind
        # is the expected one, not audio.state.
        RINGARGS="$RINGARGS $(hostint_args "$D") $(sound_ring_args "$D" win "$AUDIO_EXPECT")"
      fi
      printf 'exec %q %s --socket wl-proxy --runtime-dir %q --transport arena --arena-ivshmem %q --arena-run %q --arena-id 0 %s --copy %s %s --pace-frames 60 --accept-timeout %s --timeout %s >%q 2>&1\n' \
        "$BIN/wc-proxy" "$UPARGS" "$D" "$ARENA" "$RUN" "$RINGARGS" "$COPY_SCOPE" "$DMABUF_ARGS" \
        "${WC_LAUNCH_SESSION_SECS:-43200}" "${WC_LAUNCH_SESSION_SECS:-43200}" "$D/proxy.log"
    } >"$D/proxy.sh"
    chmod 755 "$D/proxy.sh"
    export XDG_RUNTIME_DIR="/run/user/$UID_"
    systemctl --user reset-failed "$UNIT" 2>/dev/null
    systemd-run --user --unit="$UNIT" --collect "$(command -v bash)" "$D/proxy.sh" >/dev/null 2>&1 \
      || die "systemd-run --user could not start $UNIT (is this user's manager running? loginctl enable-linger)"
    for _ in $(seq 1 1000); do [ -S "$D/wl-proxy" ] && break; sleep 0.01; done
    if [ ! -S "$D/wl-proxy" ]; then
      echo "wc-session: the proxy never bound its socket" >&2
      tail -20 "$D/proxy.log" 2>/dev/null | sed 's/^/  /' >&2
      exit 1
    fi
    [ -n "$APID" ] && wait "$APID"
    [ $SERVICE = 1 ] || audio_up "$D" "$ID"
    echo "proxy ok $D/wl-proxy (as $(id -un), ivshmem$([ $SERVICE = 1 ] && echo ', no ssh: control, sound and feeds on rings'))"
    # §89: what the proxy made of the rings, in its own words. It attaches
    # them after it binds its socket, so the line is waited for briefly.
    if [ $SERVICE = 1 ]; then
      T=""
      for _ in $(seq 1 200); do
        T=$(grep -m1 -oE 'wayland rings: .*' "$D/proxy.log" 2>/dev/null) && [ -n "$T" ] && break
        sleep 0.01
      done
      echo "transport ${T:-the proxy said nothing about the rings in 2 s (see $D/proxy.log)}"
    elif [ "$(cat "$D/transport" 2>/dev/null)" = rings ]; then
      T=""
      for _ in $(seq 1 200); do
        T=$(grep -m1 -oE '(wayland rings: .*|SSH FALLBACK: .*)' "$D/proxy.log" 2>/dev/null) && [ -n "$T" ] && break
        sleep 0.01
      done
      echo "transport ${T:-SSH FALLBACK: the proxy said nothing about the rings in 2 s (see $D/proxy.log)}"
    else
      echo "transport SSH FALLBACK: $(sed 's/^ssh: //' "$D/transport" 2>/dev/null || echo 'up found no rings')"
    fi
    echo "audio $(cat "$D/audio.state")"
    exit 0
  fi
  [ -f "$D/arena.plan" ] || die "no plan for $ID -- call up first"
  # §94: the root unit only where `up` was allowed to write a plan.
  [ "${WC_LAUNCH_GUEST_RAM:-}" = 1 ] || die "the guest-RAM proxy (as root) is not served on this host (§94)"
  # §103.14: with a located ring region there is no upstream socket at all.
  UPSTREAM_ARGS=""
  if [ -f "$D/rings.plan" ]; then
    audio_up "$D" "$ID"
    # §103.15: the VM's doorbell hub (sv-hostd bell-hub on the rings' legacy
    # virtio-serial port), or polling when the VM has none.
    MACBELL=poll
    [ -n "${WC_LAUNCH_MAC_BELL:-}" ] && [ -S "$WC_LAUNCH_MAC_BELL" ] && MACBELL=$WC_LAUNCH_MAC_BELL
    UPSTREAM_ARGS=$(printf -- '--wayland-rings-plan %q --wayland-bell %q --session-control %q --session-id %q' "$D/rings.plan" "$MACBELL" "$BASE/wc-session" "$ID")
    # §106: host integration on the same rings.
    UPSTREAM_ARGS="$UPSTREAM_ARGS $(hostint_args "$D")"
    UPSTREAM_ARGS="$UPSTREAM_ARGS $(sound_ring_args "$D" mac)"
  else
    [ -S "$D/up.sock" ] || die "no upstream socket for $ID -- the guest's tunnel is not up"
    UPSTREAM_ARGS=$(printf -- '--upstream %q' "$D/up.sock")
  fi
  [ -x "$BIN/wc-proxy" ] || die "no $BIN/wc-proxy"
  UNIT="wc-launch-$ID"
  cat >"$D/proxy.sh" <<EOF
#!/usr/bin/env bash
export PATH=/run/current-system/sw/bin:/run/wrappers/bin
# §103.14: this host's settings, for the wc-session the control channel runs.
$(env | grep '^WC_LAUNCH_' | sed 's/^/export /; s/=\(.*\)$/="\1"/')
rm -f "$D/wl-proxy"
"$BIN/wc-proxy" $UPSTREAM_ARGS --socket wl-proxy --runtime-dir "$D" \\
  --transport arena --arena-plan "$D/arena.plan" --arena-id 0 --copy damage $DMABUF_ARGS --pace-frames 60 \\
  --arena-grow --arena-grow-step ${WC_LAUNCH_GROW_STEP:-16777216} \\
  --arena-locator "$BIN/wc-arena-host" --arena-qmp "$QMP" --arena-vm "$VM_HINT" \\
  --accept-timeout ${WC_LAUNCH_SESSION_SECS:-43200} --timeout ${WC_LAUNCH_SESSION_SECS:-43200} \\
  >"$D/proxy.log" 2>&1 &
P=\$!
for _ in \$(seq 1 200); do [ -S "$D/wl-proxy" ] && break; sleep 0.05; done
chown $UID_:$GID_ "$D/wl-proxy" 2>/dev/null
wait \$P
EOF
  chmod 755 "$D/proxy.sh"
  BASH=$(command -v bash)
  if [ "${WC_LAUNCH_GUEST_RAM_USER:-}" = 1 ]; then
    # §103: QEMU runs as this user (the macOS test VM on devhost), so its QMP
    # socket and /proc/<pid>/fd are this user's and neither the locate nor the
    # proxy needs root: a user unit, as on the ivshmem path. Pair it with
    # WC_LAUNCH_ROOTC=bash so `up` runs the locate as this user too.
    export XDG_RUNTIME_DIR="/run/user/$UID_"
    systemctl --user reset-failed "$UNIT" 2>/dev/null
    systemd-run --user --unit="$UNIT" --collect "$BASH" "$D/proxy.sh" >/dev/null 2>&1 \
      || die "systemd-run --user could not start $UNIT"
  else
    printf 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin\nsystemctl reset-failed %q 2>/dev/null\nsystemd-run --unit=%q --collect %q %q >/dev/null 2>&1\necho started\n' \
      "$UNIT" "$UNIT" "$BASH" "$D/proxy.sh" | eval "$ROOTC" >/dev/null 2>&1
  fi
  for _ in $(seq 1 200); do [ -S "$D/wl-proxy" ] && break; sleep 0.05; done
  if [ ! -S "$D/wl-proxy" ]; then
    echo "wc-session: the proxy never bound its socket" >&2
    tail -20 "$D/proxy.log" 2>/dev/null | sed 's/^/  /' >&2
    exit 1
  fi
  # On rings (§103.14) the sound was started before the proxy, which plays it.
  [ -f "$D/rings.plan" ] || audio_up "$D" "$ID"
  echo "proxy ok $D/wl-proxy"
  echo "audio $(cat "$D/audio.state")"
  ;;

# --------------------------------------------------------------------- app ---
# docs/waycompose-design.md §92. Everything the guest needs to build the
# application's Start menu entry, its pinned button's name and icon, and its
# jump list's tasks: `wc-proxy desktop info` (name, actions, localised names),
# one icon per Firefox task, and the application's icon as `icon` prints it.
#
#   wc-session app APP THEME      THEME is light or dark: the colour the task
#                                 glyphs are drawn in
#
# §94: APP is the host's id, and the desktop entry and the executable whose
# package it is read from are the definition's. Until §94 the guest sent the
# executable, and so chose which directories were searched.
app)
  words 1 2 "APP [light|dark]" "$@"
  APPID="${1:-}"; load_app "$APPID"
  THEME="${2:-light}"; case "$THEME" in light|dark) ;; *) die "app: theme is light or dark" ;; esac
  [ -x "$BIN/wc-proxy" ] || die "no $BIN/wc-proxy"
  INFO=$("$BIN/wc-proxy" desktop --dirs "$(app_dirs "$DEF_EXEC")" info "$DEF_DESKTOP" 2>&1) || die "app $APPID: $INFO"
  printf '%s\n' "$INFO"
  # THE TASKS' OWN ICONS. Windows' Firefox draws "new tab", "new window" and
  # "new private window" with three icons of its own; the Linux package has the
  # same glyphs as SVGs in its chrome skin, drawn with `context-fill`, which is
  # Firefox's "the colour of the text around me". So they are filled here in
  # the colour of the jump list's text and rasterised at 32 px. Only for
  # Firefox, only from an unpacked chrome directory (the readback package has
  # one; a stock package keeps it in omni.ja and its tasks wear the app icon),
  # and only with rsvg-convert -- without it the tasks wear the app icon too.
  if [ "$(sed -n 's/^program //p' <<<"$INFO")" = firefox ] && RSVG=$(store_tool librsvg rsvg-convert); then
    EXE="$DEF_EXEC"
    SKIN="$(dirname "$(dirname "$(readlink -f "$EXE")")")/lib/firefox/browser/chrome/browser/skin/classic/browser"
    if [ "$THEME" = dark ]; then INK='#fbfbfe'; PRIV='#c689ff'; else INK='#15141a'; PRIV='#8000d7'; fi
    for pair in new-tab:new-tab.svg:"$INK" new-window:window.svg:"$INK" new-private-window:privateBrowsing.svg:"$PRIV"; do
      IFS=: read -r ACT FILE COLOUR <<<"$pair"
      [ -f "$SKIN/$FILE" ] || continue
      PNG=$(sed -e "s/context-fill-opacity/1/g; s/context-stroke-opacity/1/g" \
                -e "s/context-fill/$COLOUR/g; s/context-stroke/$COLOUR/g" "$SKIN/$FILE" \
              | "$RSVG" -w 32 -h 32 -f png 2>/dev/null | base64 -w0)
      [ -n "$PNG" ] && echo "taskicon $ACT $PNG"
    done
  fi
  # The application's icon, as the install step has always fetched it.
  env -u SSH_ORIGINAL_COMMAND bash "$0" icon "$APPID" || true
  ;;

# ------------------------------------------------------- run, action, open ---
# §94. The application, one of its desktop entry's actions (a jump-list task),
# or a URL (a frequent page), through the session's proxy:
#
#   wc-session run    ID APP DPI CAPTION
#   wc-session action ID APP ACTION DPI CAPTION
#   wc-session open   ID APP B64URL DPI CAPTION
#
# `launch` builds the argv from $APPS and the desktop entry. A task that starts
# the application cold gets the profile, preferences and title bar a click on
# the shortcut would, because all three come from the one definition.
#
# The word counts are exact. `run` with a command line -- `run ID B64CMD
# B64PROFILE B64PREFS B64TITLEBAR [B64CHROME [B64GTK]]`, the form before §94 --
# is seven or eight words and is refused here by its count, and its third word,
# base64, is not an application id even when it happens to fit the alphabet:
# no section of $APPS is called that.
run)
  words 4 4 "ID APP DPI CAPTION: an application id from $APPS, never a command line (§94)" "$@"
  launch run "$1" "$2" "" "$3" "$4"
  ;;
action)
  words 5 5 "ID APP ACTION DPI CAPTION (§94)" "$@"
  [[ "$3" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,63}$ ]] || die "bad action id"
  launch action "$1" "$2" "$3" "$4" "$5"
  ;;
open)
  words 5 5 "ID APP B64URL DPI CAPTION (§94)" "$@"
  # base64 of at most 4096 bytes. The URL itself must be http(s):// or
  # file:/// -- so never `-`-leading, never an option -- with every byte
  # printable ASCII and no quote or backslash; wc-proxy's `url_ok` checks the
  # same again before it puts it in the entry's `%u` slot.
  [[ "$3" =~ ^[A-Za-z0-9+/]{4,5464}={0,2}$ ]] || die "open: the URL is not base64 of at most 4096 bytes"
  URL=$(printf '%s' "$3" | base64 -d 2>/dev/null) || die "open: bad base64"
  [ "${#URL}" -le 4096 ] || die "open: URL longer than 4096 bytes"
  case "$URL" in
    http://*|https://*|HTTP://*|HTTPS://*|file:///*) ;;
    *) die "open: only http://, https:// and file:/// URLs are opened" ;;
  esac
  case "$URL" in *\"*|*\\*|*$'\n'*) die "open: URL with a quote, a backslash or a newline" ;; esac
  printf '%s' "$URL" | LC_ALL=C grep -q '[^!-~]' && die "open: URL with whitespace, a control character or non-ASCII"
  launch open "$1" "$2" "$URL" "$4" "$5"
  ;;

# ---------------------------------------------------------------- frequent ---
# §92. The jump list's "Frequent" (and, if the profile asks, "Recent") pages,
# from the launcher's own Firefox profile, the way Windows' Firefox builds its
# own: history sorted by visit count (frequent) or by last visit (recent), as
# many as `browser.taskbar.lists.maxListItemCount` says, each with its favicon.
#
#   wc-session frequent APP
#
# §94: the profile is the definition's. Until §94 the guest named a directory
# under ~/.wc-launch, and so could read the history of any launcher profile on
# this machine, another installation's included.
#
# Prints `prefs ...` and then `item KIND B64URL B64TITLE B64ICON` lines (`-` for
# no title or icon). Firefox's own switches are respected: with
# `browser.taskbar.lists.enabled` or `…frequent.enabled` false there are no
# frequent items, and `…tasks.enabled` is passed on for the guest's tasks.
#
# PRIVACY. This is the user's browsing history, crossing to the Windows side
# exactly as Windows' Firefox puts its own in its jump list. It is read from
# copies made in a 0700 directory and removed before this exits, and nothing
# here logs a URL or a title: they go to the guest on stdout and nowhere else.
# Private windows write no history, so nothing from one can appear.
frequent)
  words 1 1 "APP" "$@"
  load_app "$1"; PROFILE="$DEF_PROFILE"
  [ -n "$PROFILE" ] && [ -f "$PROFILE/places.sqlite" ] || { echo "prefs none"; exit 0; }
  SQLITE=$(store_tool sqlite sqlite3) || die "frequent: no sqlite3 on this host (WC_LAUNCH_SQLITE)"
  pref() {  # NAME DEFAULT: user.js wins over prefs.js, as Firefox reads them
    local v
    v=$(grep -h "^user_pref(\"$1\"," "$PROFILE/prefs.js" "$PROFILE/user.js" 2>/dev/null | tail -1 \
          | sed 's/^user_pref("[^"]*", *\(.*\));.*$/\1/')
    echo "${v:-$2}"
  }
  LISTS=$(pref browser.taskbar.lists.enabled true)
  FREQ=$(pref browser.taskbar.lists.frequent.enabled true)
  RECENT=$(pref browser.taskbar.lists.recent.enabled false)
  TASKS=$(pref browser.taskbar.lists.tasks.enabled true)
  MAX=$(pref browser.taskbar.lists.maxListItemCount 7)
  REFRESH=$(pref browser.taskbar.lists.refreshInSeconds 120)
  case "$REFRESH" in *[!0-9]*|"") REFRESH=120 ;; esac
  case "$MAX" in *[!0-9]*|"") MAX=7 ;; esac
  [ "$MAX" -gt 20 ] && MAX=20
  echo "prefs lists=$LISTS frequent=$FREQ recent=$RECENT tasks=$TASKS max=$MAX refresh=$REFRESH"
  [ "$LISTS" = true ] || exit 0
  T=$(mktemp -d "${TMPDIR:-/tmp}/wc-frequent-XXXXXX") || die "frequent: mktemp"
  chmod 700 "$T"
  trap 'rm -rf "$T"' EXIT
  # Copies, because Firefox holds the databases open; with their write-ahead
  # logs, so the copy has the visits of the last few minutes too.
  for f in places.sqlite places.sqlite-wal favicons.sqlite favicons.sqlite-wal; do
    [ -f "$PROFILE/$f" ] && cp "$PROFILE/$f" "$T/$f" 2>/dev/null
  done
  q() { "$SQLITE" -batch -noheader -separator $'\t' "$1" "$2" 2>/dev/null; }
  # The guest drops items the user removed from the list, and items whose URL
  # it cannot carry, so twice the count is asked for.
  N=$((MAX * 2))
  SCHEMES="(url LIKE 'http://%' OR url LIKE 'https://%' OR url LIKE 'file:///%')"
  {
    [ "$FREQ" = true ] && q "$T/places.sqlite" \
      "SELECT 'frequent', replace(base64(CAST(url AS BLOB)), char(10), ''), replace(base64(CAST(coalesce(title, '') AS BLOB)), char(10), '') FROM moz_places WHERE hidden = 0 AND visit_count > 0 AND $SCHEMES ORDER BY visit_count DESC, last_visit_date DESC LIMIT $N;"
    [ "$RECENT" = true ] && q "$T/places.sqlite" \
      "SELECT 'recent', replace(base64(CAST(url AS BLOB)), char(10), ''), replace(base64(CAST(coalesce(title, '') AS BLOB)), char(10), '') FROM moz_places WHERE hidden = 0 AND last_visit_date IS NOT NULL AND $SCHEMES ORDER BY last_visit_date DESC LIMIT $N;"
  } | while IFS=$'\t' read -r KIND B64URL B64TITLE; do
    [ -n "$B64URL" ] || continue
    URL=$(printf '%s' "$B64URL" | base64 -d 2>/dev/null)
    ICON=""
    if [ -f "$T/favicons.sqlite" ]; then
      U=${URL//\'/\'\'}
      # The page's own icon nearest 32 px, raster before SVG (width 65535);
      # then the site's root /favicon.ico, which Firefox keeps unlinked.
      ICON=$(q "$T/favicons.sqlite" \
        "SELECT replace(base64(i.data), char(10), '') FROM moz_pages_w_icons p JOIN moz_icons_to_pages ip ON ip.page_id = p.id JOIN moz_icons i ON i.id = ip.icon_id WHERE p.page_url = '$U' ORDER BY (i.width = 65535), abs(i.width - 32) LIMIT 1;")
      if [ -z "$ICON" ]; then
        ORIGIN=$(sed -n 's|^\(https\{0,1\}://[^/]*\).*$|\1|p' <<<"$URL")
        [ -n "$ORIGIN" ] && ICON=$(q "$T/favicons.sqlite" \
          "SELECT replace(base64(data), char(10), '') FROM moz_icons WHERE root = 1 AND icon_url = '${ORIGIN//\'/\'\'}/favicon.ico' ORDER BY abs(width - 32) LIMIT 1;")
      fi
      ICON=$(tr -d '\n' <<<"$ICON")
      # An SVG favicon, rasterised when this host can; otherwise none.
      printf '%s' "$ICON" | base64 -d >"$T/icon.svg" 2>/dev/null
      HEAD=$(head -c 256 "$T/icon.svg" | tr -d '\0')
      if [ -n "$ICON" ] && case "$HEAD" in *"<svg"*|*"<?xml"*) true ;; *) false ;; esac; then
        ICON=""
        RSVG=$(store_tool librsvg rsvg-convert) \
          && ICON=$("$RSVG" -w 32 -h 32 -f png "$T/icon.svg" 2>/dev/null | base64 -w0)
      fi
    fi
    echo "item $KIND $B64URL ${B64TITLE:--} ${ICON:--}"
  done
  # The pipeline's status is whatever its last test said (pipefail), and a
  # list that ended on a page without a favicon is still a list.
  exit 0
  ;;

# -------------------------------------------------------------------- icon ---
# The application's icon, from *this* machine's theme, because that is the only
# machine that has one -- §16's whole finding, and the same reason the taskbar
# icon has to cross. Emitted as base64 PNG; the guest wraps it in an .ico for
# the shortcut. Largest first, because a shortcut is drawn at 48 and Windows
# would rather downscale than blow up a 16.
icon)
  words 1 1 "APP" "$@"
  APPID="$1"; load_app "$APPID"
  # §94: the executable is the definition's, and the entry is its `desktop`.
  # Until §94 the guest sent the executable as a second word, so it chose the
  # store prefix this searched.
  #
  # §17.2 recorded that stage 11's resolver published `0 image(s)` for
  # "firefox", "because the resolver runs where the proxy runs and the VM host
  # has no icon theme carrying Firefox's pixels". That is true of the *system*
  # theme and false of the package: on NixOS a program's icons live under its
  # own store path, next to its bin. So the first place looked at is the prefix
  # of the executable this launcher is about to run — which is exact by
  # construction, needs no theme, and cannot resolve to a different Firefox.
  EXEC="$DEF_EXEC"
  P=$(dirname "$(dirname "$(readlink -f "$EXEC")")")
  DIRS="$P/share"
  # A wrapped program is a shell script in one store path while its icons are
  # in the package's own, so the executable's prefix is not always enough.
  # The package by name is, and this is install time -- a store listing here
  # costs nothing anybody waits for.
  for extra in $(ls -d /nix/store/*-"$(basename "$EXEC")"-[0-9]*/share 2>/dev/null | sort -V | tail -2); do
    DIRS="$DIRS $extra"
  done
  DIRS="$DIRS /run/current-system/sw/share $HOME/.nix-profile/share /usr/share"
  APPID="$DEF_DESKTOP"
  NAME="$APPID"
  for d in $DIRS; do
    [ -f "$d/applications/$APPID.desktop" ] || continue
    I=$(grep -m1 '^Icon=' "$d/applications/$APPID.desktop" | cut -d= -f2-)
    # A theme name only: an `Icon=` that is a path, or has `..` in it, would
    # turn the lookup below into a read of some other file (§94).
    [[ "$I" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] && [[ "$I" != *..* ]] && NAME="$I"
    break
  done
  for size in 256x256 128x128 96x96 64x64 48x48; do
    for d in $DIRS; do
      f="$d/icons/hicolor/$size/apps/$NAME.png"
      [ -f "$f" ] || continue
      echo "icon $NAME $size"
      base64 -w0 <"$f"; echo
      exit 0
    done
  done
  die "no icon for $APPID"
  ;;

# -------------------------------------------------------------------- down ---
down)
  words 1 1 "ID" "$@"
  ID="${1:-}"; check_id "$ID"
  D=$(dir_of "$ID")
  # The user unit first, always: stopping one that does not exist costs
  # nothing. Root only for a guest-RAM session, which is the kind that wrote a
  # plan; an ivshmem session never had a root unit to stop (§83).
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user stop "wc-launch-$ID" 2>/dev/null
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user reset-failed "wc-launch-$ID" 2>/dev/null
  # §103.16: a sound ring's devices on the user's own server outlive the
  # proxy that made them; the session's own server goes with its unit.
  if [ -s "$D/sound.modules" ] && [[ "$(cut -d' ' -f1 "$D/audio.state" 2>/dev/null)" =~ ^(system|user-pipewire)$ ]] && PACTL=$(pulse_bin pactl 2>/dev/null); then
    while read -r m; do
      [[ "$m" =~ ^[0-9]+$ ]] && PULSE_SERVER="unix:/run/user/$UID_/pulse/native" "$PACTL" unload-module "$m" 2>/dev/null
    done <"$D/sound.modules"
  fi
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user stop "wc-launch-audio-$ID" 2>/dev/null
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user reset-failed "wc-launch-audio-$ID" 2>/dev/null
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user stop "wc-launch-gpu-$ID" 2>/dev/null
  XDG_RUNTIME_DIR="/run/user/$UID_" systemctl --user reset-failed "wc-launch-gpu-$ID" 2>/dev/null
  if [ -f "$D/arena.plan" ] && [ "${WC_LAUNCH_GUEST_RAM:-}" = 1 ]; then
    printf 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin\nsystemctl stop %q 2>/dev/null\nsystemctl reset-failed %q 2>/dev/null\ntrue\n' \
      "wc-launch-$ID" "wc-launch-$ID" | eval "$ROOTC" >/dev/null 2>&1
  fi
  rm -rf "$D"
  echo "down ok"
  ;;

# --------------------------------------------------------------------- gpu ---
# The forwarded GPU for one session (§86, §87, §97). The guest's launcher has
# started one GPU process on the GPU arena's ivshmem device, which keeps an
# offer in the pool's mailboxes (the device's header granule). This starts
# `sv-hostd ivshmem-serve --cold pool` in a user unit, **as this user**: it
# opens $GPUREGION read-write -- the file QEMU backs the device's BAR with,
# 0660 root:wc-arena -- and serves every ICD that connects to $D/icd.sock a
# session of its own, claimed from a mailbox and checked before handing it
# over; no socket reaches the guest. Its wakes go through the shared hub
# (--cold-bell). Without the hub, with $BELL present, it holds the doorbell's
# port itself and shares it with every ICD on $D/bell.sock. No root, no
# broker, nothing that can read guest RAM: security-model.md R30.
#
# N is the guest's own cap on concurrent sessions and is only checked here.
gpu)
  words 1 2 "ID [N]" "$@"
  ID="${1:-}"; check_id "$ID"; N="${2:-1}"
  case "$N" in [1-8]) ;; *) die "gpu: 1..8 sessions, not '$N'" ;; esac
  D=$(dir_of "$ID")
  [ -d "$D" ] || die "no session $ID"
  [ -x "$BIN/sv-hostd" ] || die "no $BIN/sv-hostd"
  # §103.15: a guest with no shared-memory device (the macOS VM). Its main
  # process started the GPU server, whose extent is a window of guest RAM with
  # the cold page first, offered under the session's label (its id, cut to
  # the label's 16 bytes). sv-hostd finds it in QEMU's memory backend, as the
  # session's own locate did: this user, a user unit, no socket into the VM.
  if [ -f "$D/rings.plan" ]; then
    [ "${WC_LAUNCH_GUEST_RAM:-}" = 1 ] || die "the guest-RAM GPU is not served on this host (§94)"
    UNIT="wc-launch-gpu-$ID"
    LABEL=${ID:0:16}
    {
      echo '#!/usr/bin/env bash'
      echo 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin'
      printf 'rm -f %q\n' "$D/icd.sock"
      printf 'exec %q qemu-serve --qmp %q --vm %q --cold %q --socket %q --clients %q >%q 2>&1\n' \
        "$BIN/sv-hostd" "$QMP" "$VM_HINT" "mem:$LABEL" "$D/icd.sock" "$N" "$D/hostd.log"
    } >"$D/gpu.sh"
    chmod 755 "$D/gpu.sh"
    export XDG_RUNTIME_DIR="/run/user/$UID_"
    systemctl --user reset-failed "$UNIT" 2>/dev/null
    systemd-run --user --unit="$UNIT" --collect "$(command -v bash)" "$D/gpu.sh" >/dev/null 2>&1 \
      || die "systemd-run --user could not start $UNIT"
    for _ in $(seq 1 600); do [ -S "$D/icd.sock" ] && break; sleep 0.05; done
    if [ ! -S "$D/icd.sock" ]; then
      echo "wc-session: sv-hostd qemu-serve did not take the GPU server's offer (label $LABEL):" >&2
      tail -6 "$D/hostd.log" 2>/dev/null | sed 's/^/  /' >&2
      exit 1
    fi
    # The GPU rings' doorbell: the VM's hub on its second port, which the
    # server in the VM opened (--bell); this session's ICDs connect to it.
    rm -f "$D/bell.path"
    if [ -n "${WC_LAUNCH_MAC_GPU_BELL:-}" ] && [ -S "$WC_LAUNCH_MAC_GPU_BELL" ]; then
      printf '%s\n' "$WC_LAUNCH_MAC_GPU_BELL" >"$D/bell.path"
    fi
    echo "gpu ok at $D/icd.sock (guest RAM, label $LABEL, as $(id -un)$([ -s "$D/bell.path" ] && echo ", doorbell $(cat "$D/bell.path")" || echo ', no doorbell: polled'))"
    exit 0
  fi
  [ -r "$GPUREGION" ] && [ -w "$GPUREGION" ] \
    || die "cannot open the GPU arena $GPUREGION as $(id -un) (is the VM's GPU ivshmem device configured, and this user in its group?)"
  UNIT="wc-launch-gpu-$ID"
  BELLARGS=""
  rm -f "$D/bell.path"
  if hub_up; then
    # §99: the shared hub holds the port; this session's ICDs connect to it.
    printf '%s\n' "$HUBDIR/sv.sock" >"$D/bell.path"
    BELLARGS=$(printf -- '--cold-bell %q' "$HUBDIR/sv.sock")
  elif [ -S "$BELL" ] && [ -w "$BELL" ]; then
    echo "wc-session: NO SHARED DOORBELL HUB ($HUBDIR): this session holds QEMU's doorbell port itself, and no other session can have it until this one is gone (§99)" >&2
    BELLARGS=$(printf -- '--bell %q --bell-hub %q' "$BELL" "$D/bell.sock")
  fi
  {
    echo '#!/usr/bin/env bash'
    echo 'export PATH=/run/current-system/sw/bin:/run/wrappers/bin'
    printf 'rm -f %q %q\n' "$D/icd.sock" "$D/bell.sock"
    printf 'exec %q ivshmem-serve --region %q --cold pool --socket %q %s >%q 2>&1\n' \
      "$BIN/sv-hostd" "$GPUREGION" "$D/icd.sock" "$BELLARGS" "$D/hostd.log"
  } >"$D/gpu.sh"
  chmod 755 "$D/gpu.sh"
  export XDG_RUNTIME_DIR="/run/user/$UID_"
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  systemd-run --user --unit="$UNIT" --collect "$(command -v bash)" "$D/gpu.sh" >/dev/null 2>&1 \
    || die "systemd-run --user could not start $UNIT"
  for _ in $(seq 1 500); do [ -S "$D/icd.sock" ] && break; sleep 0.01; done
  if [ ! -S "$D/icd.sock" ]; then
    echo "wc-session: sv-hostd ivshmem-serve never listened:" >&2
    tail -6 "$D/hostd.log" 2>/dev/null | sed 's/^/  /' >&2
    exit 1
  fi
  grep -E 'doorbell' "$D/hostd.log" | sed 's/^sv-hostd: /gpu /'
  echo "gpu ok up to $N session(s) at $D/icd.sock (as $(id -un), ivshmem $GPUREGION$([ -s "$D/bell.path" ] && echo ", doorbell via the shared hub $(cat "$D/bell.path")")$([ -S "$D/bell.sock" ] && echo ', doorbell held by this session'))"
  ;;

# ------------------------------------------------------------------- audio ---
# The session's sound, as raw PCM on stdout: s16le, 48 kHz, stereo, for as
# long as the reader keeps the channel open (§86). A diagnostic: the launcher
# reads $D/audio.sock through its tunnel instead. `parec` gets SIGPIPE when the
# ssh channel closes, so a launcher that goes away takes this with it.
audio)
  words 1 1 "ID" "$@"
  ID="${1:-}"; check_id "$ID"
  D=$(dir_of "$ID")
  AUDIO=$(cat "$D/audio.state" 2>/dev/null || echo "none: no session $ID")
  case "$AUDIO" in pulse*|pipewire*|user-pipewire*) ;; *) die "no audio for $ID: $AUDIO" ;; esac
  PAREC=$(pulse_bin parec) || die "no parec on this host"
  # §106.3: through the session PipeWire's pulse socket, from whatever the
  # default output is (a host device's node, or the fallback null sink).
  case "$AUDIO" in
    pipewire*|user-pipewire*)
      exec env PULSE_SERVER="unix:$(sed -n 's/^[a-z-]* \([^ ]*\) .*/\1/p' "$D/audio.state")" \
        "$PAREC" --device=@DEFAULT_MONITOR@ --format=s16le --rate=$AUDIO_RATE --channels=2 --latency-msec=20 --raw 2>>"$D/parec.log"
      ;;
  esac
  exec env PULSE_SERVER="unix:$D/xdg/pulse/native" PULSE_RUNTIME_PATH="$D/xdg/pulse" HOME="$D/pulse-home" \
    "$PAREC" --device=wc.monitor --format=s16le --rate=$AUDIO_RATE --channels=2 --latency-msec=20 --raw 2>>"$D/parec.log"
  ;;

status)
  words 1 1 "ID" "$@"
  ID="${1:-}"; check_id "$ID"
  D=$(dir_of "$ID")
  [ -S "$D/wl-proxy" ] && echo "status up $D" || echo "status down $D"
  ;;

logs)
  words 1 1 "ID" "$@"
  ID="${1:-}"; check_id "$ID"
  D=$(dir_of "$ID")
  for f in locate.log proxy.log app.log; do
    [ -f "$D/$f" ] || continue
    echo "=== $f"
    tail -60 "$D/$f"
  done
  ;;

# ---------------------------------------------------------- operator verbs ---
# §94. For the person and the deploy step on this machine, from argv. Refused
# from the guest: they read configuration and resolve names, which is nothing
# the guest's key needs.
apps)
  [ -z "$GUEST" ] || die "apps is an operator verb, not served to the guest"
  [ -f "$APPS" ] || die "no $APPS"
  N=0
  for A in $(sed -n 's/^[[:space:]]*\[\([^]]*\)\][[:space:]]*$/\1/p' "$APPS"); do
    ( load_app "$A"
      printf 'app %s exec %s profile %s titlebar %s desktop %s gpu %s args %s env %s\n' "$A" "$DEF_EXEC" \
        "${DEF_PROFILE:--}" "$DEF_TITLEBAR" "$DEF_DESKTOP" "$DEF_GPU" "${#DEF_ARGS[@]}" "${#DEF_ENV[@]}" ) || exit 1
    N=$((N + 1))
  done
  [ "$N" -gt 0 ] || die "$APPS defines no application"
  echo "apps ok $N"
  ;;
resolve)
  [ -z "$GUEST" ] || die "resolve is an operator verb, not served to the guest"
  [ -n "${1:-}" ] || die "resolve NAME"
  resolve_exec "$1" || die "cannot find $1 on this machine"
  ;;
# §106.3: write a private PipeWire stack for DIR, as `WC_LAUNCH_AUDIO=pipewire`
# would for a session, and print the script that runs it in the foreground.
# For scripts/wc-hostint-local.sh, which tests the same configuration.
pw-stack)
  [ -z "$GUEST" ] || die "pw-stack is an operator verb, not served to the guest"
  [ -n "${1:-}" ] && [ -d "$1" ] || die "pw-stack DIR (an existing directory)"
  PSD=$(cd "$1" && pwd)
  WHY=$(pw_stack_write "$PSD") || die "pw-stack: $WHY"
  echo "$PSD/pipewire.sh"
  ;;

*)
  die "unknown verb ${VERB:0:32}; try ping|up|proxy|gpu|run|action|open|app|frequent|audio|icon|down|status|logs"
  ;;
esac
