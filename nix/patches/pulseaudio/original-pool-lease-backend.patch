+/* Admission must precede any exported blocks. A reservation covers the
+ * entire backing pool, not merely its currently used block extents. */
+int pa_memexport_enable_original_quarantine(pa_memexport *e) {
+    int current, size;
+    pa_assert(e);
+    pa_assert(!e->used_slots);
+    if (e->quarantine_reserved)
+        return 0;
+    if (e->pool->memory.type != PA_MEM_TYPE_SHARED_MEMFD)
+        return -1;
+    if (e->pool->memory.size > PA_ORIGINAL_QUARANTINE_MAX)
+        return -1;
+    size = (int) e->pool->memory.size;
+    do {
+        current = pa_atomic_load(&original_quarantine_reserved);
+        if (current > PA_ORIGINAL_QUARANTINE_MAX - size)
+            return -1;
+    } while (!pa_atomic_cmpxchg(&original_quarantine_reserved, current, current + size));
+    e->quarantine_reserved = true;
+    return 0;
+}
