 void pa_memexport_free(pa_memexport *e) {
     pa_assert(e);
 
     pa_mutex_lock(e->mutex);
+    if (e->quarantine_reserved && e->used_slots) {
+        struct memexport_slot *slot;
+        /* These source-owned refs prevent allocator reuse and pool vacuum.
+         * No dead transport callback is kept reachable from pool exporters. */
+        for (slot = e->used_slots; slot; slot = slot->next)
+            pa_assert(!slot->block->foreign_origin);
+        e->revoke_cb = NULL;
+        e->userdata = NULL;
+        pa_mutex_unlock(e->mutex);
+        pa_mutex_lock(e->pool->mutex);
+        PA_LLIST_REMOVE(pa_memexport, e->pool->exports, e);
+        pa_mutex_unlock(e->pool->mutex);
+        pa_log_warn("Quarantined original export pool until process exit: size=%lu",
+                    (unsigned long) e->pool->memory.size);
+        return;
+    }
     while (e->used_slots)
         pa_memexport_process_release(e, (uint32_t) (e->used_slots - e->slots + e->baseidx));
     pa_mutex_unlock(e->mutex);
