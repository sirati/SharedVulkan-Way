+#ifdef OS_IS_DARWIN
+/* Pulse's memfd wire protocol needs an anonymous shared fd, not Linux seals.
+ * No Pulse path calls F_ADD_SEALS. Never expose this as a generic memfd syscall. */
+static int anonymous_shared_fd(mode_t mode) {
+    char leaf[32], *name;
+    unsigned id[2];
+    int fd, saved_errno, attempt;
+
+    for (attempt = 0; attempt < 16; attempt++) {
+        pa_random(id, sizeof(id));
+        pa_snprintf(leaf, sizeof(leaf), "pulse-fd-%08x-%08x", id[0], id[1]);
+        if (!(name = pa_runtime_path(leaf)))
+            return -1;
+        fd = pa_open_cloexec(name, O_RDWR|O_CREAT|O_EXCL, mode);
+        if (fd < 0) {
+            saved_errno = errno;
+            pa_xfree(name);
+            if (saved_errno == EEXIST)
+                continue;
+            errno = saved_errno;
+            return -1;
+        }
+        if (unlink(name) < 0) {
+            saved_errno = errno;
+            pa_close(fd);
+            pa_xfree(name);
+            errno = saved_errno;
+            return -1;
+        }
+        pa_xfree(name);
+        return fd;
+    }
+    errno = EEXIST;
+    return -1;
+}
+#endif
