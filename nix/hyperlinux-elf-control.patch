+extern int guest_control_layout_overlap(uint64_t guest_size, uint64_t off,
+                                         uint64_t len);
+
+static int elf_write_span(uint64_t guest_size, uint64_t gpa, uint64_t len) {
+    return len <= guest_size && gpa <= guest_size - len &&
+           !guest_control_layout_overlap(guest_size, gpa, len);
+}
+static int elf_zero_span(uint64_t guest_size, uint64_t gpa, uint64_t memsz,
+                         uint64_t *zero_len) {
+    if (memsz > guest_size || gpa > guest_size - memsz ||
+        memsz > UINT64_MAX - 4095) return -1;
+    *zero_len = (memsz + 4095) & ~4095ULL;
+    if (*zero_len > guest_size - gpa) *zero_len = guest_size - gpa;
+    return elf_write_span(guest_size, gpa, *zero_len) ? 0 : -1;
+}
