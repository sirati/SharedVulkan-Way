+
+/* Restore needs a stable identity, including for legacy regular files. */
+int hl_fd_get_replaceable(int guest_fd, hl_fd_ref_t *out) {
+    if (!out || guest_fd < 0 || guest_fd >= FD_TABLE_SIZE) { errno = EBADF; return -1; }
+    pthread_mutex_lock(&fd_lock);
+    fd_entry_t *entry = &fd_table[guest_fd];
+    if (entry->type != FD_REGULAR) {
+        pthread_mutex_unlock(&fd_lock); errno = EBADF; return -1;
+    }
+    if (!entry->desc) {
+        hl_open_file_t *of = entry->of;
+        int created = !of;
+        if (!of) of = hl_open_file_create(FD_REGULAR, &hl_fd_ops_host_file,
+            entry->linux_flags & ~LINUX_O_CLOEXEC, NULL);
+        if (!of) { pthread_mutex_unlock(&fd_lock); errno = ENOMEM; return -1; }
+        hl_descriptor_t *d = hl_descriptor_create(of, entry->host_fd,
+            entry->linux_flags & LINUX_O_CLOEXEC, entry->type, entry->dir);
+        if (!d) {
+            pthread_mutex_unlock(&fd_lock);
+            if (created) hl_open_file_release(of);
+            errno = ENOMEM; return -1;
+        }
+        entry->of = of;
+        entry->desc = d;
+    }
+    hl_descriptor_t *d = entry->desc;
+    if (!d->of || atomic_load(&d->removed)) {
+        pthread_mutex_unlock(&fd_lock); errno = EBADF; return -1;
+    }
+    hl_descriptor_retain(d);
+    if (d->of) hl_open_file_retain(d->of);
+    *out = (hl_fd_ref_t){ .desc = d, .of = d->of, .host_fd = d->host_fd,
+        .guest_fd = guest_fd, .fd_flags = atomic_load(&d->fd_flags) };
+    pthread_mutex_unlock(&fd_lock);
+    return 0;
+}
+
+/* Consume replacement ownership even when a concurrent close/reuse wins. */
+int hl_fd_install_if_current(const hl_fd_ref_t *expected, hl_open_file_t *of,
+                             int host_fd, uint32_t fd_flags) {
+    if (!of || of->kind != FD_REGULAR || !expected || !expected->desc ||
+        expected->desc->type != FD_REGULAR || expected->guest_fd < 0 ||
+        expected->guest_fd >= FD_TABLE_SIZE) {
+        if (of) hl_open_file_release(of);
+        if (host_fd >= 0) close(host_fd);
+        errno = EBADF; return -1;
+    }
+    hl_descriptor_t *replacement = hl_descriptor_create(of, host_fd, fd_flags, of->kind, NULL);
+    if (!replacement) {
+        hl_open_file_release(of); if (host_fd >= 0) close(host_fd);
+        errno = ENOMEM; return -1;
+    }
+    int guest_fd = expected->guest_fd;
+    pthread_mutex_lock(&fd_lock);
+    hl_descriptor_t *old = fd_table[guest_fd].desc;
+    if (old != expected->desc || fd_table[guest_fd].type == FD_CLOSED || atomic_load(&old->removed)) {
+        pthread_mutex_unlock(&fd_lock);
+        hl_descriptor_release(replacement); errno = EAGAIN; return -1;
+    }
+    atomic_store(&old->removed, true);
+    fd_table[guest_fd].desc = replacement;
+    hl_fd_sync_legacy(guest_fd);
+    pthread_mutex_unlock(&fd_lock);
+    hl_descriptor_release(old);
+    return guest_fd;
+}
 
