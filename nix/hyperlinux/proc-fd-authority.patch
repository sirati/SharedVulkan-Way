+/* procfd opens must not turn protocol sockets into untyped host aliases.
+ * Resolve the guest descriptor (including guest stdio), pin its native alias,
+ * then reject sockets as Linux does for opening socket procfd paths. */
+static int proc_guest_fd_open(int guest_fd) {
+    hl_fd_ref_t ref __attribute__((cleanup(hl_fd_put))) = {0};
+    if (hl_fd_get_pinned(guest_fd, &ref) < 0 || ref.host_fd < 0) {
+        errno = EBADF; return -1;
+    }
+    int type; socklen_t length = sizeof(type);
+    if ((ref.of && (ref.of->kind == FD_SOCKET ||
+         (ref.of->ops != &hl_fd_ops_host_file && ref.of->ops != &hl_fd_ops_host_dir))) ||
+        getsockopt(ref.host_fd, SOL_SOCKET, SO_TYPE, &type, &length) == 0) {
+        errno = ENXIO; return -1;
+    }
+    return fcntl(ref.host_fd, F_DUPFD_CLOEXEC, 0);
+}
 
