+typedef struct {
+    hl_fd_ref_t ref;
+    int type;
+    void *vdir;
+    char *hint;
+} vfs_dirfd_snapshot_t;
+
+static void vfs_dirfd_drop(vfs_dirfd_snapshot_t *s) {
+    free(s->hint);
+    if (s->vdir) hl_vdir_release(s->vdir);
+    hl_fd_put(&s->ref);
+}
+
+/* Snapshot identity and path ownership together. Never consult the guest
+ * number again after releasing lifecycle exclusion. VFS locks are leaf
+ * locks and are only acquired after this snapshot is complete. */
+static int vfs_dirfd_snapshot(int guest_fd, vfs_dirfd_snapshot_t *s) {
+    HL_FD_LIFECYCLE_SCOPE;
+    memset(s, 0, sizeof(*s));
+    if (hl_fd_get_pinned(guest_fd, &s->ref) < 0) return -LINUX_EBADF;
+    pthread_mutex_lock(&fd_lock);
+    s->type = fd_table[guest_fd].type;
+    if (s->type == FD_VIRTUAL_DIR) {
+        s->vdir = fd_table[guest_fd].dir;
+        if (s->vdir) hl_vdir_retain(s->vdir);
+    }
+    const char *hint = s->ref.of ? s->ref.of->guest_path_hint : NULL;
+    if (hint) s->hint = strdup(hint);
+    int failed = hint && !s->hint;
+    pthread_mutex_unlock(&fd_lock);
+    if (failed) { vfs_dirfd_drop(s); return -LINUX_ENOMEM; }
+    return 0;
+}
 
