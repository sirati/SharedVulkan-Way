+                              uint64_t *available, int write) {
+    if (available) *available = 0;
+    if (!length || length - 1 > UINT64_MAX - va) return NULL;
+    uint64_t span;
+    void *first = gva_resolve(g, va, &span, write);
+    if (!first || !span) return NULL;
+    uint64_t done = span < length ? span : length;
+    while (done < length) {
