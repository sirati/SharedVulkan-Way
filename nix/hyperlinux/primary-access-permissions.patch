+        if (!next || !next_span || done > UINTPTR_MAX - (uintptr_t)first ||
+            (uintptr_t)next != (uintptr_t)first + done) break;
+        uint64_t remain = length - done;
+        done += next_span < remain ? next_span : remain;
+    }
+    if (available) *available = done;
+    return first;
