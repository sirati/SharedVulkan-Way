  *
  * Both modes check exit_group_requested so the main thread also reacts
  * to exit_group called by a worker. */
+/* Cancellation can interrupt live EL0 code rather than a shim HVC. Signal
+ * frames still use the shim's ELR/SPSR convention. Do not inject while an EL1
+ * shim save/restore is incomplete; retain the pending signal for a safe HVC. */
+static int deliver_canceled_signal(hv_vcpu_t vcpu, guest_t *g, int *exit_code) {
+    uint64_t pc, pstate;
+    if (hv_vcpu_get_reg(vcpu, HV_REG_PC, &pc) != HV_SUCCESS ||
+        hv_vcpu_get_reg(vcpu, HV_REG_CPSR, &pstate) != HV_SUCCESS)
+        goto failed;
+    if ((pstate & 0x1f) != 0)
+        return 0;
+    if (hv_vcpu_set_sys_reg(vcpu, HV_SYS_REG_ELR_EL1, pc) != HV_SUCCESS ||
+        hv_vcpu_set_sys_reg(vcpu, HV_SYS_REG_SPSR_EL1, pstate) != HV_SUCCESS)
+        goto failed;
+    int ret = signal_deliver(vcpu, g, exit_code);
+    if (ret <= 0) return ret;
+    if (hv_vcpu_get_sys_reg(vcpu, HV_SYS_REG_ELR_EL1, &pc) != HV_SUCCESS ||
+        hv_vcpu_get_sys_reg(vcpu, HV_SYS_REG_SPSR_EL1, &pstate) != HV_SUCCESS ||
+        hv_vcpu_set_reg(vcpu, HV_REG_PC, pc) != HV_SUCCESS ||
+        hv_vcpu_set_reg(vcpu, HV_REG_CPSR, pstate) != HV_SUCCESS)
+        goto failed;
+    return ret;
+failed:
+    crash_report(vcpu, g, CRASH_UNEXPECTED_EC,
+                 "failed to synchronize canceled signal context");
+    *exit_code = 128;
+    return -1;
+}
