--- a/src/egl/drivers/dri2/platform_wayland.c
+++ b/src/egl/drivers/dri2/platform_wayland.c
@@ -43,6 +43,7 @@
 
 #include "util/anon_file.h"
 #include "util/perf/cpu_trace.h"
+#include "util/u_debug.h"
 #include "util/u_vector.h"
 #include "util/format/u_formats.h"
 #include "main/glconfig.h"
@@ -3211,6 +3212,19 @@
    NULL,
 };
 
+/* LIBGL_KOPPER_DRI2, as platform_x11.c reads it: with Zink, take the kopper
+ * path even when the compositor offers no DRM device -- no wl_drm and no
+ * dma-buf feedback, i.e. a wl_shm-only compositor -- because kopper presents
+ * through the Vulkan driver's own VK_KHR_wayland_surface and needs none.
+ * Without it, such a compositor gets swrast whatever Vulkan driver is present.
+ */
+static bool
+dri2_wl_force_kopper(const _EGLDisplay *disp)
+{
+   return disp->Options.Zink &&
+          debug_get_bool_option("LIBGL_KOPPER_DRI2", false);
+}
+
 static EGLBoolean
 dri2_initialize_wayland_swrast(_EGLDisplay *disp)
 {
@@ -3262,7 +3276,11 @@
    if (!dri2_create_screen(disp))
       goto cleanup;
 
-   if (!dri2_setup_device(disp, disp->Options.ForceSoftware)) {
+   /* Under LIBGL_KOPPER_DRI2 there is no DRM node to name, so the EGLDevice
+    * is the software one, exactly as platform_x11.c does for the same case.
+    */
+   if (!dri2_setup_device(disp, disp->Options.ForceSoftware ||
+                                   dri2_wl_force_kopper(disp))) {
       _eglError(EGL_NOT_INITIALIZED, "DRI2: failed to setup EGLDevice");
       goto cleanup;
    }
@@ -3297,7 +3315,7 @@
 EGLBoolean
 dri2_initialize_wayland(_EGLDisplay *disp)
 {
-   if (disp->Options.ForceSoftware)
+   if (disp->Options.ForceSoftware || dri2_wl_force_kopper(disp))
       return dri2_initialize_wayland_swrast(disp);
    else
       return dri2_initialize_wayland_drm(disp);
