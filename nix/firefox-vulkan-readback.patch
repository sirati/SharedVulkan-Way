@@ -415,6 +424,17 @@ bool FFmpegVideoDecoder<LIBAV_VER>::CreateVulkanDeviceContext(
 #    if LIBAVUTIL_VERSION_INT >= AV_VERSION_INT(60, 32, 100)
   queueCreateFlags = vkCtx->queue_flags;
 #    endif
+  // The readback path uses none of the copy ring InitCtx sets up, and InitCtx
+  // requires the DMA-BUF and sync_fd export entry points a non-exporting device
+  // does not have.
+  if (VulkanReadbackEnabled()) {
+    if (!mLib->av_hwframe_transfer_data) {
+      FFMPEG_LOG("[VULKAN] readback wanted but av_hwframe_transfer_data missing");
+      return false;
+    }
+    FFMPEG_LOG("[VULKAN] readback: decoded frames are copied to host memory");
+    return true;
+  }
   if (!mVulkanDecoder.InitCtx(
           vkCtx->act_dev, vkCtx->phys_dev, vkCtx->get_proc_addr, vkCtx->inst,
           mVulkanDeviceHolder->Generation(), VulkanTransferQueueFamily(vkCtx),
@@ -2295,6 +2315,77 @@ static uint32_t DRMFormatForColorDepth(const gfx::ColorDepth aDepth) {
   }
 }
 
+// Tier 1 of shared_vulkan docs/design.md §0.21.9: the decoded frame is copied
+// into host memory by ffmpeg (vkCmdCopyImageToBuffer underneath) and handed on
+// as an ordinary PlanarYCbCrImage, the type the software decoder produces and
+// the RDD process already knows how to send. No DMA-BUF, no sync_fd.
+//
+// 8-bit NV12 only. Anything else is a DECODE_ERR, which MediaFormatReader
+// recovers from by retrying with hardware decoding disabled, so a 10-bit
+// stream falls back to software instead of failing the element.
+MediaResult FFmpegVideoDecoder<LIBAV_VER>::CreateImageVulkanReadback(
+    int64_t aOffset, int64_t aPts, int64_t aDuration,
+    MediaDataDecoder::DecodedData& aResults) {
+  AVFrame* sw = mLib->av_frame_alloc();
+  if (!sw) {
+    return MediaResult(NS_ERROR_OUT_OF_MEMORY,
+                       RESULT_DETAIL("av_frame_alloc failed"));
+  }
+  auto freeSw = MakeScopeExit([&] { mLib->av_frame_free(&sw); });
+  // sw->format left unset: ffmpeg picks the frames context's sw_format.
+  int err = mLib->av_hwframe_transfer_data(sw, mFrame, 0);
+  if (err < 0) {
+    FFMPEG_LOG("[VULKAN] readback: av_hwframe_transfer_data failed: {}", err);
+    return MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                       RESULT_DETAIL("Vulkan readback failed (%d)", err));
+  }
+  if (sw->format != AV_PIX_FMT_NV12) {
+    FFMPEG_LOG("[VULKAN] readback: format {} is not handled, only NV12",
+               sw->format);
+    return MediaResult(NS_ERROR_DOM_MEDIA_DECODE_ERR,
+                       RESULT_DETAIL("Vulkan readback: not NV12"));
+  }
+
+  const uint32_t w = mFrame->width;
+  const uint32_t h = mFrame->height;
+  VideoData::YCbCrBuffer b;
+  b.mPlanes[0].mData = sw->data[0];
+  b.mPlanes[0].mStride = sw->linesize[0];
+  b.mPlanes[0].mWidth = w;
+  b.mPlanes[0].mHeight = h;
+  b.mPlanes[0].mSkip = 0;
+  // NV12: one interleaved CbCr plane, so Cb and Cr are the same plane one byte
+  // apart, each skipping the other's sample.
+  for (int i = 1; i <= 2; i++) {
+    b.mPlanes[i].mData = sw->data[1] + (i - 1);
+    b.mPlanes[i].mStride = sw->linesize[1];
+    b.mPlanes[i].mWidth = (w + 1) / 2;
+    b.mPlanes[i].mHeight = (h + 1) / 2;
+    b.mPlanes[i].mSkip = 1;
+  }
+  b.mChromaSubsampling = gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT;
+  b.mColorDepth = gfx::ColorDepth::COLOR_8;
+  b.mYUVColorSpace = GetFrameColorSpace();
+  b.mColorPrimaries = GetFrameColorPrimaries();
+  b.mColorRange = GetFrameColorRange();
+
+  VideoInfo info = mInfo;
+  info.mTransferFunction = GetFrameTransferFunction();
+  Result<already_AddRefed<VideoData>, MediaResult> r =
+      VideoData::CreateAndCopyData(
+          info, mImageContainer, aOffset, TimeUnit::FromMicroseconds(aPts),
+          TimeUnit::FromMicroseconds(aDuration), b, IsKeyFrame(mFrame),
+          TimeUnit::FromMicroseconds(mFrame->pkt_dts),
+          info.ScaledImageRect(w, h), mImageAllocator);
+  if (r.isErr()) {
+    return r.unwrapErr();
+  }
+  RefPtr<VideoData> v = r.unwrap();
+  FFMPEG_LOGV("[VULKAN] readback: {}x{} frame copied to host memory", w, h);
+  aResults.AppendElement(std::move(v));
+  return NS_OK;
+}
