diff --git a/src/kosmickrisp/bridge/mtl_texture.m b/src/kosmickrisp/bridge/mtl_texture.m
index 496ce14..50011b4 100644
--- a/src/kosmickrisp/bridge/mtl_texture.m
+++ b/src/kosmickrisp/bridge/mtl_texture.m
@@ -13,6 +13,64 @@
 #include "vulkan/vulkan.h"
 
 #include <Metal/MTLTexture.h>
+#include <Metal/MTLDevice.h>
+#include <IOSurface/IOSurface.h>
+#include <stdint.h>
+
+mtl_texture *
+mtl_new_nv12_chroma_texture(mtl_texture *texture, uint32_t width,
+                             uint32_t height, uint64_t offsets[2],
+                             uint32_t strides[2], uint64_t sizes[2])
+{
+   @autoreleasepool {
+      id<MTLTexture> tex = (id<MTLTexture>)texture;
+      IOSurfaceRef surface = tex.iosurface;
+      if (!width || !height || !surface || tex.iosurfacePlane != 0 ||
+          tex.pixelFormat != MTLPixelFormatR8Unorm ||
+          tex.textureType != MTLTextureType2D || tex.width != width ||
+          tex.height != height || tex.mipmapLevelCount != 1 ||
+          tex.arrayLength != 1 || tex.sampleCount != 1 ||
+          !(tex.usage & MTLTextureUsageShaderRead) ||
+          IOSurfaceGetPlaneCount(surface) != 2 ||
+          IOSurfaceGetWidth(surface) != width ||
+          IOSurfaceGetHeight(surface) != height)
+         return NULL;
+      /* 420v and 420f differ in range, which Vulkan's conversion specifies. */
+      uint32_t format = IOSurfaceGetPixelFormat(surface);
+      if (format != 0x34323076 && format != 0x34323066)
+         return NULL;
+      size_t allocation = IOSurfaceGetAllocSize(surface);
+      for (unsigned p = 0; p < 2; p++) {
+         size_t w = p ? (width / 2u + width % 2u) : width;
+         size_t h = p ? (height / 2u + height % 2u) : height;
+         size_t element = p ? 2u : 1u;
+         size_t stride = IOSurfaceGetBytesPerRowOfPlane(surface, p);
+         uintptr_t base = (uintptr_t)IOSurfaceGetBaseAddress(surface);
+         uintptr_t plane = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface, p);
+         if (!base || plane < base)
+            return NULL;
+         size_t offset = plane - base;
+         if (IOSurfaceGetWidthOfPlane(surface, p) != w ||
+             IOSurfaceGetHeightOfPlane(surface, p) != h ||
+             IOSurfaceGetBytesPerElementOfPlane(surface, p) != element ||
+             stride < w * element || stride > UINT32_MAX ||
+             offset > allocation || h > (allocation - offset) / stride)
+            return NULL;
+         offsets[p] = offset;
+         strides[p] = stride;
+         sizes[p] = h * stride;
+      }
+      if (offsets[0] + sizes[0] > offsets[1])
+         return NULL;
+      MTLTextureDescriptor *desc = [MTLTextureDescriptor
+         texture2DDescriptorWithPixelFormat:MTLPixelFormatRG8Unorm
+         width:(width / 2u + width % 2u) height:(height / 2u + height % 2u) mipmapped:NO];
+      desc.storageMode = tex.storageMode;
+      desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+      return [tex.device newTextureWithDescriptor:desc iosurface:surface plane:1];
+   }
+}
