#version 450
// Fixture only. Work and memory indices are bounded by literals, even if
// command-state restoration supplies arbitrary push constant contents.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint words[]; } input_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint words[]; } output_data;
layout(push_constant) uniform Push { uint words; uint kernel; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 1024u || pc.words != 1024u || pc.kernel != 1u) { return; }
    if ((i & 1023u) < 64u) { return; }
    output_data.words[i] = input_data.words[i];
}
